        <GradientStop Color="{DynamicResource CardCornerMidTint}" Offset="0.5" />
        <GradientStop Color="{DynamicResource CardSurfaceTint}" Offset="1" />
    </RadialGradientBrush>

    <ControlTemplate x:Key="CalendarNavigationButtonTemplate" TargetType="Button">
        <Border x:Name="navBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8">
            <Grid>
                <Border x:Name="hoverFill" Background="{DynamicResource CalendarNavArrowHoverBackground}"
                        CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                <Border x:Name="pressedFill" Background="{DynamicResource CalendarNavArrowPressedBackground}"
                        CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="hoverFill" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="hoverFill" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.11" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="pressedFill" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.07" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="pressedFill" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.1" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="navBorder" Property="BorderBrush" Value="{DynamicResource AccentText}" />
                <Setter TargetName="navBorder" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="navBorder" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

