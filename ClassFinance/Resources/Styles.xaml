<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Palette  -->
    <SolidColorBrush x:Key="PrimaryRed" Color="#D32F2F" />
    <SolidColorBrush x:Key="PrimaryRedDark" Color="#B71C1C" />
    <SolidColorBrush x:Key="PrimaryRedLight" Color="#FFEBEE" />
    <SolidColorBrush x:Key="CardBackground" Color="#EAE6EF" />
    <SolidColorBrush x:Key="SidebarBackground" Color="#B71C1C" />
    <SolidColorBrush x:Key="AppBackground" Color="#F5F5F7" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleBackground" Color="#F5F5F7" />
    <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0" />
    <SolidColorBrush x:Key="TextDark" Color="#212121" />
    <SolidColorBrush x:Key="TextGray" Color="#5F6368" />
    <SolidColorBrush x:Key="AccentText" Color="#B71C1C" />
    <SolidColorBrush x:Key="StatusGreen" Color="#1B5E20" />
    <SolidColorBrush x:Key="StatusAmber" Color="#8D4B00" />
    <SolidColorBrush x:Key="StatusRed" Color="#B71C1C" />
    <SolidColorBrush x:Key="IncomeColor" Color="#C62828" />
    <SolidColorBrush x:Key="ExpenseColor" Color="#545454" />
    <SolidColorBrush x:Key="ErrorColor" Color="#B71C1C" />
    <SolidColorBrush x:Key="DisabledButtonBackground" Color="#E2E2E2" />
    <SolidColorBrush x:Key="DisabledButtonText" Color="#575757" />
    <SolidColorBrush x:Key="DisabledText" Color="#707078" />
    <SolidColorBrush x:Key="TransactionDateBackground" Color="#FFFFE0B2" />
    <SolidColorBrush x:Key="TransactionDateForeground" Color="#6D3C00" />
    <SolidColorBrush x:Key="TransactionDateBorder" Color="#AD5C00" />
    <SolidColorBrush x:Key="ActionButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ActionButtonForeground" Color="#111111" />
    <SolidColorBrush x:Key="ActionButtonBorder" Color="#D32F2F" />
    <SolidColorBrush x:Key="ActionButtonHoverBackground" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ActionButtonPressedBackground" Color="#E5E7EB" />
    <SolidColorBrush x:Key="CalendarNavBackground" Color="#F4F4F6" />
    <SolidColorBrush x:Key="CalendarNavForeground" Color="#212121" />
    <SolidColorBrush x:Key="CalendarNavBorder" Color="#C7C7D0" />
    <SolidColorBrush x:Key="CalendarNavHoverBackground" Color="#FFEBEE" />
    <SolidColorBrush x:Key="CalendarNavHoverForeground" Color="#212121" />
    <SolidColorBrush x:Key="CalendarNavPressedBackground" Color="#FFCDD2" />
    <SolidColorBrush x:Key="CalendarCurrentMonthBackground" Color="#FFEBEE" />
    <SolidColorBrush x:Key="CalendarCurrentMonthBorder" Color="#B71C1C" />
    <SolidColorBrush x:Key="CalendarSelectedMonthBackground" Color="#D32F2F" />
    <SolidColorBrush x:Key="CalendarSelectedMonthForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CalendarSelectedMonthBorder" Color="#8A1C1C" />
    <SolidColorBrush x:Key="CalendarNavFocusBorder" Color="#212121" />
    <SolidColorBrush x:Key="CalendarNavArrowBackground" Color="#F5F5F7" />
    <SolidColorBrush x:Key="CalendarNavArrowForeground" Color="#212121" />
    <SolidColorBrush x:Key="CalendarNavArrowBorder" Color="#E0E0E0" />
    <SolidColorBrush x:Key="CalendarNavArrowHoverBackground" Color="#E5E7EB" />
    <SolidColorBrush x:Key="CalendarNavArrowPressedBackground" Color="#D1D5DB" />
    <SolidColorBrush x:Key="StudentAddBackground" Color="#D32F2F" />
    <SolidColorBrush x:Key="StudentAddForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StudentAddBorder" Color="#D32F2F" />
    <SolidColorBrush x:Key="StudentAddHoverBackground" Color="#B71C1C" />
    <SolidColorBrush x:Key="StudentAddPressedBackground" Color="#B71C1C" />
    <Color x:Key="CardCornerTint">#FFF1F1</Color>
    <Color x:Key="CardCornerMidTint">#FFF9F9</Color>
    <Color x:Key="CardSurfaceTint">#FFFFFF</Color>
    <RadialGradientBrush x:Key="CardCornerFade" Center="1,0" GradientOrigin="1,0" RadiusX="0.85" RadiusY="0.8">
        <GradientStop Color="{DynamicResource CardCornerTint}" Offset="0" />
        <GradientStop Color="{DynamicResource CardCornerMidTint}" Offset="0.5" />
        <GradientStop Color="{DynamicResource CardSurfaceTint}" Offset="1" />
    </RadialGradientBrush>

    <ControlTemplate x:Key="CalendarNavigationButtonTemplate" TargetType="Button">
        <Border x:Name="navBorder" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource CalendarNavArrowHoverBackground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="navBorder" Property="Background" Value="{DynamicResource CalendarNavArrowPressedBackground}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="navBorder" Property="BorderBrush" Value="{DynamicResource AccentText}" />
                <Setter TargetName="navBorder" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="navBorder" Property="Opacity" Value="0.55" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="StudentAddButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource ThemeFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource StudentAddForeground}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="buttonBorder" Background="{DynamicResource StudentAddBackground}"
                            BorderBrush="{DynamicResource StudentAddBorder}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="24" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background" Value="{DynamicResource StudentAddHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="buttonBorder" Property="Background" Value="{DynamicResource StudentAddPressedBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="buttonBorder" Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledButtonText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeFocusVisual" TargetType="{x:Type Control}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Control}">
                    <Border BorderBrush="{DynamicResource AccentText}" BorderThickness="2"
                            CornerRadius="6" Margin="-3" IsHitTestVisible="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextDark}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
    </Style>

    <!--  Primary (filled red) button  -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ThemeFocusVisual}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="24" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <SolidColorBrush x:Name="bgBrush" Color="#D32F2F" />
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bgBrush" Storyboard.TargetProperty="Color"
                                                        To="#B71C1C" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bgBrush" Storyboard.TargetProperty="Color"
                                                        To="#D32F2F" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledButtonText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        "Pop" button: a white pill button meant to sit on top of a colored card
        (e.g. the Tarik Kas button on the red Total Saldo card). Colors are
        self-contained rather than TemplateBinding'd. Hovering smoothly animates
        the background from white to deep red and the text from red to white,
        plus a soft glow, instead of any instant color snap.
    -->
    <Style x:Key="PopButton" TargetType="Button">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="24" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <SolidColorBrush x:Name="borderBrush" Color="White" />
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect x:Name="shadow" Color="#B71C1C" Direction="270"
                                               BlurRadius="0" ShadowDepth="0" Opacity="0" />
                        </Border.Effect>
                        <TextBlock x:Name="contentText" Text="{TemplateBinding Content}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="fgBrush" Color="#B71C1C" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Color"
                                                        To="#C62828" Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="fgBrush" Storyboard.TargetProperty="Color"
                                                        To="White" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity"
                                                         To="0.45" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius"
                                                         To="18" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth"
                                                         To="6" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="borderBrush" Storyboard.TargetProperty="Color"
                                                        To="White" Duration="0:0:0.18" />
                                        <ColorAnimation Storyboard.TargetName="fgBrush" Storyboard.TargetProperty="Color"
                                                        To="#B71C1C" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
                            <Setter TargetName="contentText" Property="Foreground" Value="{DynamicResource DisabledButtonText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Outline (white with red border) button  -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ThemeFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" BorderBrush="{StaticResource PrimaryRed}" BorderThickness="1.5" CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <SolidColorBrush x:Name="bgBrush" Color="White" />
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bgBrush" Storyboard.TargetProperty="Color"
                                                        To="#FFEBEE" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bgBrush" Storyboard.TargetProperty="Color"
                                                        To="White" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- High-contrast secondary action used on the balance card and history filter. -->
    <Style x:Key="ThemeActionButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ThemeFocusVisual}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionButtonForeground}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{DynamicResource ActionButtonBackground}"
                            BorderBrush="{DynamicResource ActionButtonBorder}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="20" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ActionButtonHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ActionButtonPressedBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledButtonText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmallThemeActionButton" TargetType="Button" BasedOn="{StaticResource ThemeActionButton}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <!--  Small outline button (for row actions)  -->
    <Style x:Key="SmallOutlineButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <Style x:Key="OverflowDotsButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextGray}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="dotsBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dotsBorder" Property="Background" Value="{DynamicResource SubtleBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="dotsBorder" Property="Background" Value="{DynamicResource BorderColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PopupActionMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource PopupMenuItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Opacity="0.16" ShadowDepth="3" Color="Black" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PopupMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="itemBorder" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource SubtleBackground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Sidebar nav button  -->
    <Style x:Key="SidebarButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ThemeFocusVisual}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Cursor" Value="Hand" />

        <!-- Define how the separated icon and text are rendered -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [0]}" Margin="0,0,12,0" />
                        <TextBlock Text="{Binding [1]}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="8,3">
                        <Border.Background>
                            <SolidColorBrush x:Name="bgBrush" Color="#00D32F2F" />
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bgBrush" Storyboard.TargetProperty="Color"
                                                        To="#D32F2F" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bgBrush" Storyboard.TargetProperty="Color"
                                                        To="#00D32F2F" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Active Sidebar button -->
    <Style x:Key="SidebarButtonActive" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource ThemeFocusVisual}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding [0]}" Margin="0,0,12,0" FontWeight="Normal" />
                        <TextBlock Text="{Binding [1]}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="8,3">
                        <Border.Background>
                            <SolidColorBrush x:Name="bgBrush" Color="#D32F2F" />
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bgBrush" Storyboard.TargetProperty="Color"
                                                        To="#B71C1C" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="bgBrush" Storyboard.TargetProperty="Color"
                                                        To="#D32F2F" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Text box style  -->
    <Style x:Key="RoundedTextBox" TargetType="TextBox">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextDark}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                      Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Rounded ComboBox: pill-shaped closed state matching RoundedTextBox, with a
        red chevron that flips on open, and a rounded dropdown whose items highlight
        in the app's red accent on hover/selection. Built for non-editable selection
        combos like the Riwayat Transaksi type filter.
    -->
    <Style x:Key="RoundedComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
        <Setter Property="Padding" Value="14,8,32,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ThemeFocusVisual}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Margin" Value="4,2" />
                    <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="itemBorder" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource PrimaryRedLight}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource PrimaryRed}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="toggleBorder" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="20">
                                        <Path x:Name="arrow" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource TextDark}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5">
                                            <Path.RenderTransform>
                                                <RotateTransform x:Name="arrowRotate" Angle="0" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="toggleBorder" Property="BorderBrush" Value="{DynamicResource TextDark}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="arrowRotate" Storyboard.TargetProperty="Angle"
                                                                         To="180" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="arrowRotate" Storyboard.TargetProperty="Angle"
                                                                         To="0" Duration="0:0:0.15" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left" VerticalAlignment="Center" />

                        <Popup x:Name="popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,6,0,0">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="1" Direction="270" BlurRadius="10" Color="Black" Opacity="0.2"/>
                                </Border.Effect>
                                <ScrollViewer SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Date input and calendar  -->
    <Style x:Key="CalendarDayButtonBaseStyle" TargetType="CalendarDayButton">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="dayBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="dayBorder" Property="Background" Value="{DynamicResource PrimaryRedLight}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="dayBorder" Property="BorderBrush" Value="{StaticResource PrimaryRed}" />
                            <Setter TargetName="dayBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="dayBorder" Property="Background" Value="{StaticResource PrimaryRed}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledText}" />
                            <Setter Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalendarMonthButtonBaseStyle" TargetType="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource CalendarNavForeground}" />
        <Setter Property="Background" Value="{DynamicResource CalendarNavBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CalendarNavBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="monthBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="monthBorder" Property="Background" Value="{DynamicResource CalendarNavHoverBackground}" />
                            <Setter Property="Foreground" Value="{DynamicResource CalendarNavHoverForeground}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="monthBorder" Property="Background" Value="{DynamicResource CalendarNavPressedBackground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="monthBorder" Property="BorderBrush" Value="{DynamicResource CalendarNavFocusBorder}" />
                            <Setter TargetName="monthBorder" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="HasSelectedDays" Value="True">
                <Setter Property="Background" Value="{DynamicResource CalendarCurrentMonthBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CalendarCurrentMonthBorder}" />
                <Setter Property="BorderThickness" Value="2" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CalendarBaseStyle" TargetType="Calendar">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarDayButtonBaseStyle}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource CalendarMonthButtonBaseStyle}" />
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CalendarStyle" Value="{StaticResource CalendarBaseStyle}" />
    </Style>

    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextDark}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Grid ClipToBounds="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        <TextBlock x:Name="watermark" Text="Select a date" Margin="{TemplateBinding Padding}"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextGray}"
                                   IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value="" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="watermark" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Card container  -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardCornerFade}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14" Opacity="0.08" ShadowDepth="2" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListRow" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,16" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

</ResourceDictionary>
