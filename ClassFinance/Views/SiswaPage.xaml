<Page x:Class="ClassFinance.Views.SiswaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:ClassFinance.Converters" TextElement.Foreground="{DynamicResource TextDark}"
      Title="Data Siswa" Background="{DynamicResource AppBackground}">
    <Page.Resources>
        <conv:RupiahConverter x:Key="Rupiah" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <DockPanel Margin="32,28,32,28">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Data Siswa" FontSize="24" VerticalAlignment="Center" />
            <Button x:Name="TambahButton" Grid.Column="1" Content="+ Tambah Siswa"
                    Style="{StaticResource StudentAddButton}" Click="TambahButton_Click" />
        </Grid>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Margin="0,0,0,16" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="2" CornerRadius="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Canvas Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Canvas.Left="0" Canvas.Top="0"
                                     Stroke="{DynamicResource TextGray}" StrokeThickness="1.6" />
                            <Line X1="9" Y1="9" X2="15" Y2="15" Stroke="{DynamicResource TextGray}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>

                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" 
                         Padding="0,8,10,8" VerticalContentAlignment="Center"
                         FontSize="14" Tag="Cari nama atau NIS siswa..." 
                         TextChanged="SearchBox_TextChanged" />
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="SiswaItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ElevatedListRow}" Cursor="Hand"
                                            Tag="{Binding Siswa}" MouseLeftButtonUp="SiswaRow_Click">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Siswa.Name}" FontSize="15" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Siswa.Nis, StringFormat='NIS: {0}'}" FontSize="12" Foreground="{DynamicResource TextGray}" Margin="0,0,12,0" />
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource StatusGreen}">
                                        <Run Text="Saldo Titipan: Rp "/>
                                        <Run Text="{Binding Siswa.SaldoTitipan, StringFormat={}{0:N0}}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <WrapPanel Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding TotalDibayar, Converter={StaticResource Rupiah}, StringFormat='Total dibayar: {0}'}"
                                                               FontSize="12" Foreground="{DynamicResource TextDark}" Margin="0,0,12,4" />
                                                    <TextBlock Text="{Binding UnpaidCount, StringFormat='Belum bayar {0} tagihan'}"
                                                               FontSize="12" Foreground="{DynamicResource StatusAmber}"
                                                               Visibility="{Binding HasUnpaid, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="{Binding ProsesCount, StringFormat='Proses {0} tagihan'}"
                                                               FontSize="12" Foreground="{DynamicResource StatusAmber}" Margin="0,0,12,4"
                                                               Visibility="{Binding HasProses, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="Lunas semua tagihan" FontSize="12" Foreground="{DynamicResource StatusGreen}"
                                                               Visibility="{Binding IsFullyPaid, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Text="Belum ada tagihan" FontSize="12" Foreground="{DynamicResource TextGray}"
                                                               Visibility="{Binding HasNoTagihan, Converter={StaticResource BoolToVis}}" />
                                                </WrapPanel>
                                            </StackPanel>

                                            <Button Grid.Column="1" Content="•••" Style="{StaticResource OverflowDotsButton}"
                                                    ToolTip="Aksi siswa: ubah atau hapus"
                                                    AutomationProperties.Name="Aksi siswa"
                                                    AutomationProperties.HelpText="Buka menu untuk mengubah atau menghapus data siswa."
                                                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}"
                                                    PreviewMouseDown="StudentActionMenuButton_PreviewMouseDown"
                                                    Click="ShowStudentActions_Click"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyText" Text="Belum ada siswa terdaftar di kelas ini." Foreground="{DynamicResource TextGray}"
                   HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Page>
