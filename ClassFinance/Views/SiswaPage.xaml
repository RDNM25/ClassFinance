<Page x:Class="ClassFinance.Views.SiswaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:ClassFinance.Converters"
      TextElement.Foreground="{DynamicResource TextDark}"
      Title="Data Siswa" Background="{DynamicResource PageBackground}">
    <Page.Resources>
        <conv:RupiahConverter x:Key="Rupiah" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="StudentRosterRow" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Effect" Value="{x:Null}" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ElevatedCardBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-2" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.12">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StudentPaginationButton" TargetType="Button">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextGray}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StudentPaginationArrowButton" TargetType="Button"
               BasedOn="{StaticResource StudentPaginationButton}">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="17" />
        </Style>
        <Style x:Key="WeekNavigationArrowButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ArrowSurface" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowSurface" Property="Background" Value="{DynamicResource ElevatedCardBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="SiswaScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="28,0,28,30">
        <StackPanel MaxWidth="1320" Width="{Binding ViewportWidth, ElementName=SiswaScrollViewer}"
                    HorizontalAlignment="Center" Margin="0,24,0,0">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="KASMATE  /  DATA SISWA" FontSize="10"
                               Foreground="{DynamicResource AccentText}" Margin="0,0,0,5" />
                    <TextBlock Text="Data Siswa" FontSize="24" FontWeight="Medium"
                               Foreground="{DynamicResource TextDark}" />
                </StackPanel>
                <Button x:Name="TambahButton" Grid.Column="1" Content="+ Tambah Siswa"
                        Style="{StaticResource StudentAddButton}" Click="TambahButton_Click"
                        VerticalAlignment="Center" />
            </Grid>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20" Height="150">
                    <Grid Margin="-20">
                        <Border CornerRadius="12" Background="{DynamicResource CashFlowIncomeFill}" IsHitTestVisible="False">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0.15,1">
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="0.95" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource ElevatedCardBackground}"
                                        Margin="0,0,10,0">
                                    <Path Data="M12,12 C14.2,12 16,10.2 16,8 C16,5.8 14.2,4 12,4 C9.8,4 8,5.8 8,8 C8,10.2 9.8,12 12,12 Z M4,20 C4,16.7 7.6,14 12,14 C16.4,14 20,16.7 20,20"
                                          Stroke="{DynamicResource TextGray}" StrokeThickness="1.5" Fill="Transparent"
                                          Width="19" Height="19" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Siswa terdaftar" FontSize="11" FontWeight="Medium"
                                           Foreground="{DynamicResource TextGray}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,13,0,0">
                                <TextBlock x:Name="StudentCountText" Text="0" FontSize="30" FontWeight="Medium"
                                           Foreground="{DynamicResource TextDark}" />
                                <TextBlock Text="Siswa" FontSize="12" Foreground="{DynamicResource TextGray}"
                                           VerticalAlignment="Bottom" Margin="8,0,0,4" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20" Height="150">
                    <Grid Margin="-20">
                        <Border CornerRadius="12" Background="{DynamicResource CashFlowExpenseFill}" IsHitTestVisible="False">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0.15,1">
                                    <GradientStop Color="#FF000000" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="0.95" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Grid Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="190" Height="34" HorizontalAlignment="Left"
                                        Background="{DynamicResource SubtleBackground}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="9" Padding="3,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PreviousWeekButton" Content="‹"
                                                Style="{StaticResource WeekNavigationArrowButton}"
                                                ToolTip="Minggu sebelumnya" AutomationProperties.Name="Minggu sebelumnya"
                                                Click="PreviousWeekButton_Click" />
                                        <ComboBox x:Name="WeekSelectorComboBox" Grid.Column="1"
                                                  Style="{StaticResource RoundedComboBox}"
                                                  Height="28" Padding="2,0,24,0" FontSize="9" FontWeight="Medium"
                                                  Background="Transparent" BorderThickness="0"
                                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                  Tag="WeekSelector"
                                                  MaxDropDownHeight="200"
                                                  ToolTip="Pilih minggu kas" AutomationProperties.Name="Pilih minggu kas"
                                                  DropDownOpened="WeekSelectorComboBox_DropDownOpened"
                                                  SelectionChanged="WeekSelectorComboBox_SelectionChanged" />
                                        <Button x:Name="NextWeekButton" Grid.Column="2" Content="›"
                                                Style="{StaticResource WeekNavigationArrowButton}"
                                                ToolTip="Minggu berikutnya" AutomationProperties.Name="Minggu berikutnya"
                                                Click="NextWeekButton_Click" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,13,0,0" VerticalAlignment="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                    <Border x:Name="WeekOverdueBadge" Background="{DynamicResource WarningBadgeBackground}"
                                            CornerRadius="7" Padding="7,3" HorizontalAlignment="Right">
                                        <TextBlock x:Name="WeekOverdueText" Text="0 Tertunggak" FontSize="9"
                                                   Foreground="{DynamicResource StatusRed}" />
                                    </Border>
                                    <TextBlock x:Name="WeekOutstandingText" Text="Rp 0" FontSize="16" FontWeight="Medium"
                                               Foreground="{DynamicResource StatusRed}" Margin="0,5,0,0"
                                               TextAlignment="Right" HorizontalAlignment="Right" />
                                </StackPanel>
                                <TextBlock x:Name="WeekPaidText" Grid.Column="0" Text="0 / 0 lunas" FontSize="16"
                                           FontWeight="Medium" Foreground="{DynamicResource TextDark}" VerticalAlignment="Bottom"
                                           HorizontalAlignment="Left" Margin="0,0,10,2" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource ElevatedCardBackground}"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            CornerRadius="14" Height="38" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⌕" FontSize="18" Foreground="{DynamicResource TextGray}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                     Padding="0,6,10,6" VerticalContentAlignment="Center" FontSize="11"
                                     Tag="Cari nama atau NIS siswa..." TextChanged="SearchBox_TextChanged" />
                        </Grid>
                    </Border>
                    <ComboBox x:Name="FilterCombo" Grid.Column="2" Style="{StaticResource RoundedComboBox}"
                              Height="38" SelectedIndex="0" SelectionChanged="FilterCombo_SelectionChanged">
                        <ComboBoxItem Content="Semua siswa" Tag="All" />
                        <ComboBoxItem Content="Belum lunas" Tag="Unpaid" />
                        <ComboBoxItem Content="Lunas" Tag="Paid" />
                        <ComboBoxItem Content="Belum ada tagihan" Tag="NoBill" />
                    </ComboBox>
                    <ComboBox x:Name="SortCombo" Grid.Column="4" Style="{StaticResource RoundedComboBox}"
                              Height="38" SelectedIndex="1" SelectionChanged="SortCombo_SelectionChanged">
                        <ComboBoxItem Content="Tunggakan terbanyak" Tag="Unpaid" />
                        <ComboBoxItem Content="Nama A–Z" Tag="Name" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <Border Background="{DynamicResource ElevatedCardBackground}" CornerRadius="9" Padding="10,9" Margin="0,0,0,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="2.2*" />
                                <ColumnDefinition Width="1.45*" />
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="1.45*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="SISWA &amp; IDENTITAS" FontSize="9" Foreground="{DynamicResource TextGray}" />
                            <TextBlock Grid.Column="2" Text="STATUS KAS" FontSize="9" Foreground="{DynamicResource TextGray}" />
                            <TextBlock Grid.Column="3" Text="TOTAL TERBAYAR" FontSize="9" Foreground="{DynamicResource TextGray}" TextAlignment="Left" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="5" Text="TERAKHIR BAYAR" FontSize="9" Foreground="{DynamicResource TextGray}" Margin="10,0,0,0" />
                        </Grid>
                    </Border>

                    <ItemsControl x:Name="SiswaItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource StudentRosterRow}" Cursor="Hand" Focusable="True"
                                        KeyboardNavigation.IsTabStop="True" Tag="{Binding Siswa}"
                                        MouseLeftButtonUp="SiswaRow_Click" KeyDown="SiswaRow_KeyDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="1.45*" />
                                            <ColumnDefinition Width="1.15*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="1.45*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource PrimaryRedLight}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initials}" FontSize="10" FontWeight="Medium"
                                                       Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,8,0">
                                            <TextBlock Text="{Binding Siswa.Name}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextDark}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Siswa.Nis, StringFormat='NIS: {0}'}" FontSize="10"
                                                       Foreground="{DynamicResource TextGray}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="9"
                                                Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{Binding StatusForeground}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalDibayar, Converter={StaticResource Rupiah}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextDark}"
                                                   TextAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="10,0,6,0">
                                            <TextBlock Text="{Binding LastPaymentDateText}" FontSize="10" Foreground="{DynamicResource TextDark}" />
                                            <TextBlock Text="{Binding LastPaymentMethodText}" FontSize="9" Foreground="{DynamicResource TextGray}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="6" Content="•••" Style="{StaticResource OverflowDotsButton}"
                                                ToolTip="Aksi siswa: ubah atau hapus" AutomationProperties.Name="Aksi siswa"
                                                Visibility="{Binding CanManage, Converter={StaticResource BoolToVis}}"
                                                PreviewMouseDown="StudentActionMenuButton_PreviewMouseDown"
                                                Click="ShowStudentActions_Click" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyText" Text="Belum ada siswa terdaftar di kelas ini."
                               Foreground="{DynamicResource TextGray}" HorizontalAlignment="Center"
                               Margin="0,26,0,8" Visibility="Collapsed" />

                    <StackPanel x:Name="StudentPagination" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed">
                        <Button x:Name="PreviousPageButton" Content="‹" Style="{StaticResource StudentPaginationArrowButton}"
                                ToolTip="Halaman sebelumnya" AutomationProperties.Name="Halaman sebelumnya"
                                Click="PreviousPageButton_Click" />
                        <ItemsControl x:Name="PaginationPages" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Tag="{Binding PageIndex}"
                                            Click="PageNumberButton_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource StudentPaginationButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource PrimaryRed}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="NextPageButton" Content="›" Style="{StaticResource StudentPaginationArrowButton}"
                                ToolTip="Halaman berikutnya" AutomationProperties.Name="Halaman berikutnya"
                                Click="NextPageButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
