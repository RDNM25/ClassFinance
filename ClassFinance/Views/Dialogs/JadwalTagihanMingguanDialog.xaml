<UserControl x:Class="ClassFinance.Views.Dialogs.JadwalTagihanMingguanDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="440" TextElement.Foreground="{DynamicResource TextDark}">
    <StackPanel Margin="26">
        <TextBlock Text="Jadwal Tagihan Mingguan" FontSize="19" Margin="0,0,0,18" />

        <TextBlock Text="Nama Iuran" FontSize="12" Foreground="{DynamicResource TextGray}" Margin="2,0,0,4" />
        <TextBox x:Name="NameBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12" />

        <TextBlock Text="Jumlah per Siswa (Rp)" FontSize="12" Foreground="{DynamicResource TextGray}" Margin="2,0,0,4" />
        <TextBox x:Name="AmountBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12" />

        <TextBlock Text="Mulai pada minggu" FontSize="12" Foreground="{DynamicResource TextGray}" Margin="2,0,0,4" />
        <DatePicker x:Name="StartDatePicker" Margin="0,0,0,12" />
        <TextBlock Text="Minggu dihitung Senin sampai Minggu. Tanggal mulai yang dipilih akan memakai hari Senin pada minggu tersebut."
                   FontSize="11" Foreground="{DynamicResource TextGray}" Margin="2,0,0,12" TextWrapping="Wrap" />

        <TextBlock Text="Berakhir pada (opsional)" FontSize="12" Foreground="{DynamicResource TextGray}" Margin="2,0,0,4" />
        <DatePicker x:Name="EndDatePicker" Margin="0,0,0,12" />

        <CheckBox x:Name="ActiveCheckBox" Content="Jadwal aktif" IsChecked="True"
                  Foreground="{DynamicResource TextDark}" Margin="2,0,0,10" />
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentText}" FontSize="12" Margin="2,0,0,10"
                   Visibility="Collapsed" TextWrapping="Wrap" />

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Batal" Style="{StaticResource OutlineButton}" Click="Cancel_Click" />
            <Button Grid.Column="2" Content="Simpan Jadwal" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </Grid>
    </StackPanel>
</UserControl>
