<UserControl x:Class="ClassFinance.Views.Dialogs.ProfileSettingsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520" TextElement.Foreground="{DynamicResource TextDark}">
    <StackPanel Margin="26">
        <TextBlock Text="Profil" FontSize="21" FontWeight="Medium" />
        <TextBlock Text="Akun dan preferensi tampilan" FontSize="12"
                   Foreground="{DynamicResource TextGray}" Margin="0,4,0,16" />

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="60" Height="60" CornerRadius="16" Background="{DynamicResource PrimaryRed}"
                    VerticalAlignment="Center">
                <Grid>
                    <Image x:Name="PhotoPreview" Width="60" Height="60" Stretch="UniformToFill" Visibility="Collapsed">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,60,60" RadiusX="16" RadiusY="16" />
                        </Image.Clip>
                    </Image>
                    <TextBlock x:Name="InitialsPreview" Text="AB" FontSize="17" FontWeight="Medium"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="ProfileNameText" Text="Arung" FontSize="14" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ProfileUsernameText" Text="arung · Bendahara" FontSize="11"
                           Foreground="{DynamicResource TextGray}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PhotoStatusText" FontSize="10" Foreground="{DynamicResource TextGray}"
                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="3" Content="Pilih foto" Style="{StaticResource OutlineButton}"
                    Padding="11,8" VerticalAlignment="Center" Click="ChoosePhoto_Click" />
            <Button Grid.Column="5" x:Name="SavePhotoButton" Content="Simpan foto"
                    Style="{StaticResource PrimaryButton}" Padding="11,8" VerticalAlignment="Center"
                    IsEnabled="False" Visibility="Collapsed" Click="SavePhoto_Click" />
        </Grid>

        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,13" />

        <Grid Margin="0,0,0,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Tema aplikasi" FontSize="13" FontWeight="Medium" />
                <TextBlock Text="Pilihan langsung diterapkan" FontSize="10"
                           Foreground="{DynamicResource TextGray}" Margin="0,3,0,0" />
            </StackPanel>
            <ComboBox Grid.Column="1" x:Name="ThemeComboBox" Style="{StaticResource RoundedComboBox}"
                      Width="142" Height="40" FontSize="12" SelectionChanged="ThemeComboBox_SelectionChanged">
                <ComboBoxItem Content="Gelap" Tag="Dark" />
                <ComboBoxItem Content="Terang" Tag="Light" />
            </ComboBox>
        </Grid>

        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,13" />

        <TextBlock Text="Nama pengguna" FontSize="14" FontWeight="Medium" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Nama pengguna baru" FontSize="11" Foreground="{DynamicResource TextGray}" Margin="2,0,0,5" />
                <TextBox x:Name="UsernameBox" Style="{StaticResource RoundedTextBox}" Height="42" FontSize="13"
                         Padding="14,0" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Kata sandi saat ini" FontSize="11" Foreground="{DynamicResource TextGray}" Margin="2,0,0,5" />
                <PasswordBox x:Name="UsernameCurrentPasswordBox" Style="{StaticResource RoundedPasswordBox}"
                             Height="42" FontSize="13" Padding="14,0" />
            </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UsernameStatusText" FontSize="11" Foreground="{DynamicResource TextGray}"
                       VerticalAlignment="Center" Margin="2,0,10,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <Button Grid.Column="1" x:Name="SaveUsernameButton" Content="Simpan nama pengguna" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Padding="13,8" Click="SaveUsername_Click" />
        </Grid>

        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,13" />

        <TextBlock Text="Kata sandi" FontSize="14" FontWeight="Medium" Margin="0,0,0,8" />
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Kata sandi saat ini" FontSize="11" Foreground="{DynamicResource TextGray}" Margin="2,0,0,5" />
                <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource RoundedPasswordBox}"
                             Height="42" FontSize="13" Padding="14,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Kata sandi baru" FontSize="11" Foreground="{DynamicResource TextGray}" Margin="2,0,0,5" />
                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource RoundedPasswordBox}"
                             Height="42" FontSize="13" Padding="14,0" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Ulangi kata sandi baru" FontSize="11" Foreground="{DynamicResource TextGray}" Margin="2,0,0,5" />
        <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource RoundedPasswordBox}"
                     Height="42" FontSize="13" Padding="14,0" Margin="0,0,0,7" />
        <Grid Margin="0,0,0,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PasswordStatusText" FontSize="11" Foreground="{DynamicResource TextGray}"
                       VerticalAlignment="Center" Margin="2,0,10,0" Visibility="Collapsed" TextWrapping="Wrap" />
            <Button Grid.Column="1" x:Name="SavePasswordButton" Content="Ubah kata sandi" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" Padding="13,8" Click="SavePassword_Click" />
        </Grid>

        <Button Content="Selesai" HorizontalAlignment="Right" Style="{StaticResource OutlineButton}"
                Padding="16,8" Click="Cancel_Click" />
    </StackPanel>
</UserControl>
