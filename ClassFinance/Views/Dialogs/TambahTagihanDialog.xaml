<UserControl x:Class="ClassFinance.Views.Dialogs.TambahTagihanDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="380">
    <StackPanel Margin="26">
        <TextBlock Text="Buat Tagihan" FontSize="18" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBlock Text="Tagihan akan otomatis dibuat untuk setiap siswa di kelas ini." FontSize="12"
                   Foreground="{StaticResource TextGray}" Margin="0,0,0,18" TextWrapping="Wrap" />

        <TextBlock Text="Nama Tagihan" FontSize="12" Foreground="{StaticResource TextGray}" Margin="2,0,0,4" />
        <TextBox x:Name="NameBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,12" />

        <TextBlock Text="Jumlah per Siswa (Rp)" FontSize="12" Foreground="{StaticResource TextGray}" Margin="2,0,0,4" />
        <TextBox x:Name="AmountBox" Style="{StaticResource RoundedTextBox}" Margin="0,0,0,10" />

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource PrimaryRed}" FontSize="12" Margin="2,0,0,10"
                   Visibility="Collapsed" TextWrapping="Wrap" />

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Batal" Style="{StaticResource OutlineButton}" Click="Cancel_Click" />
            <Button Grid.Column="2" Content="Buat" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </Grid>
    </StackPanel>
</UserControl>
