<UserControl x:Class="ClassFinance.Views.Dialogs.StudentPaymentHistoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="900" MaxWidth="920" TextElement.Foreground="{DynamicResource TextDark}">
    <UserControl.Resources>
        <Style x:Key="StudentDialogCloseButton" TargetType="Button" BasedOn="{StaticResource ThemeActionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{DynamicResource ActionButtonBackground}"
                                BorderBrush="{DynamicResource ActionButtonBorder}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="hoverFill" Background="{DynamicResource ActionButtonHoverBackground}"
                                        CornerRadius="9" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="pressedFill" Background="{DynamicResource ActionButtonPressedBackground}"
                                        CornerRadius="9" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverFill" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverFill" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.11" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="pressedFill" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.07" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="pressedFill" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledButtonText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource CardBackground}" CornerRadius="18" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource ElevatedCardBackground}" CornerRadius="18,18,0,0">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12" Margin="22,20,0,20"
                        Background="{DynamicResource PrimaryRedLight}" VerticalAlignment="Center">
                    <TextBlock x:Name="AvatarText" Text="S" Foreground="{DynamicResource AccentText}"
                               FontSize="17" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,16,12,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="StudentNameText" Text="Siswa" FontSize="18" FontWeight="Medium"
                                   Foreground="{DynamicResource TextDark}" VerticalAlignment="Center" />
                        <Border x:Name="StatusBadge" CornerRadius="10" Padding="8,3" Margin="10,0,0,0">
                            <TextBlock x:Name="StatusText" Text="Belum ada tagihan" FontSize="10" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="StudentDetailsText" Text="NIS · Kelas" FontSize="11"
                               Foreground="{DynamicResource TextGray}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="×" Width="34" Height="34" Margin="0,18,20,0"
                        VerticalAlignment="Top" Style="{StaticResource SmallThemeActionButton}"
                        ToolTip="Tutup" Click="Close_Click" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False" MaxHeight="500">
                <StackPanel Margin="22,18,22,20">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource SubtleBackground}" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TOTAL TERBAYAR" FontSize="9" FontWeight="Medium"
                                               Foreground="{DynamicResource TextGray}" />
                                    <TextBlock x:Name="TotalPaidText" Text="Rp 0" FontSize="24" FontWeight="Medium"
                                               Foreground="{DynamicResource TextDark}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="10"
                                        Background="{DynamicResource CashFlowIncomeFill}" VerticalAlignment="Center">
                                    <TextBlock Text="✓" FontSize="19" Foreground="{DynamicResource StatusGreen}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource SubtleBackground}" CornerRadius="12" Padding="12">
                            <Button x:Name="PayButton" Content="+  Bayar kas" Style="{StaticResource PrimaryButton}"
                                    Padding="12,10" FontSize="12" Click="PayButton_Click" />
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.15*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MINGGU / PERIODE" Style="{StaticResource TableHeaderText}" />
                        <TextBlock Grid.Column="1" Text="TANGGAL" Style="{StaticResource TableHeaderText}" />
                        <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource TableHeaderText}" />
                        <TextBlock Grid.Column="3" Text="METODE" Style="{StaticResource TableHeaderText}" />
                        <TextBlock Grid.Column="4" Text="NOMINAL" Style="{StaticResource TableHeaderText}" TextAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,6" />

                    <ItemsControl x:Name="PaymentHistoryItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="1.05*" />
                                            <ColumnDefinition Width="0.9*" />
                                            <ColumnDefinition Width="1.15*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding WeekText}" FontSize="11" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextDark}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding PeriodText}" FontSize="10"
                                                   Foreground="{DynamicResource TextGray}" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="{Binding StatusBackground}" CornerRadius="8"
                                                Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="{Binding StatusForeground}" />
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding MethodText}" FontSize="10"
                                                   Foreground="{DynamicResource TextGray}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding MethodText}" />
                                        <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AmountText}" FontSize="10" FontWeight="Medium"
                                                       Foreground="{Binding AmountForeground}" TextAlignment="Right" />
                                            <TextBlock Text="{Binding RemainingText}" FontSize="9" Foreground="{DynamicResource TextGray}"
                                                       TextAlignment="Right" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyHistoryText" Text="Belum ada tagihan mingguan untuk siswa ini."
                               Foreground="{DynamicResource TextGray}" FontSize="11" Margin="0,18,0,6"
                               HorizontalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="PaymentActionStatusText" Foreground="{DynamicResource TextGray}" FontSize="11"
                               Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource ElevatedCardBackground}" CornerRadius="0,0,18,18" Padding="18,12">
                <Button Content="Tutup" Style="{StaticResource StudentDialogCloseButton}" Padding="14,8"
                        HorizontalAlignment="Right" Click="Close_Click" />
            </Border>
        </Grid>
    </Border>
</UserControl>
