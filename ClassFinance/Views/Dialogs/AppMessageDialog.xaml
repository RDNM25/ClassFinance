<Window x:Class="ClassFinance.Views.Dialogs.AppMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KasMate"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource TextDark}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Dialog_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="DialogSecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonBorder" Background="{DynamicResource SurfaceBackground}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                                <Setter TargetName="buttonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonBorder" Property="Background" Value="{DynamicResource PrimaryRedLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource TextGray}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder" Background="Transparent" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="12" Background="{DynamicResource SurfaceBackground}" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.28" />
            </Border.Effect>
        </Border>
        <Border Margin="12" Padding="26" Background="{DynamicResource SurfaceBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Width="42" Height="42" CornerRadius="14"
                        Background="{DynamicResource PrimaryRedLight}" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="IconText" Text="!" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StatusAmber}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Path x:Name="DatabaseIcon" Width="24" Height="24" Visibility="Collapsed"
                              Data="M4,5 C4,2.8 8.5,1 14,1 C19.5,1 24,2.8 24,5 C24,7.2 19.5,9 14,9 C8.5,9 4,7.2 4,5 M4,5 V19 C4,21.2 8.5,23 14,23 C19.5,23 24,21.2 24,19 V5 M4,12 C4,14.2 8.5,16 14,16 C19.5,16 24,14.2 24,12"
                              Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource StatusRed}"
                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Grid>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,0,0,0"
                           VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextDark}" />
                <Button Grid.Column="2" Content="×" Style="{StaticResource DialogCloseButton}"
                        Click="Close_Click" ToolTip="Tutup" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="60,18,12,24"
                       FontSize="14" LineHeight="22" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextGray}" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SecondaryButton" MinWidth="96" Margin="0,0,10,0"
                        Style="{StaticResource DialogSecondaryButton}" Click="Secondary_Click" />
                <Button x:Name="ConfirmButton" MinWidth="112" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
        </Border>
    </Grid>
</Window>
