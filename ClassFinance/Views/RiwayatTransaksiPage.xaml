<Page x:Class="ClassFinance.Views.RiwayatTransaksiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:ClassFinance.Converters"
      Title="Riwayat Transaksi" Background="{StaticResource AppBackground}" Width="799">
    <Page.Resources>
        <conv:TransaksiSignConverter x:Key="Sign" />
        <conv:TransaksiColorConverter x:Key="SignColor" />
        <conv:RupiahConverter x:Key="Rupiah" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
    </Page.Resources>

    <DockPanel Margin="32,28,32,28">
        <!--  Header  -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText" Grid.Column="0" Text="RIWAYAT TRANSAKSI" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />

            <ComboBox x:Name="FilterCombo" Grid.Column="2" Width="160" Margin="0,0,12,0" VerticalAlignment="Center"
                      Style="{StaticResource RoundedComboBox}" SelectedIndex="0">
                <ComboBoxItem Content="Semua" />
                <ComboBoxItem Content="Kas Masuk" />
                <ComboBoxItem Content="Kas Keluar" />
            </ComboBox>

            <Button x:Name="TambahButton" Grid.Column="3" Content="+ TAMBAH TRANSAKSI"
                    Style="{StaticResource PrimaryButton}" Click="TambahButton_Click" />
        </Grid>

        <!--  Summary cards: hidden in the per-student tagihan view  -->
        <Grid x:Name="SummaryRow" DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PrimaryRed}" CornerRadius="16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Total Kas" Foreground="#FFE0E0" FontSize="13" />
                    <TextBlock x:Name="TotalKasText" Text="Rp 0" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Total Pemasukan" Foreground="{StaticResource TextGray}" FontSize="13" />
                    <TextBlock x:Name="TotalEarnedText" Text="Rp 0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryRed}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Total Pengeluaran" Foreground="{StaticResource TextGray}" FontSize="13" />
                    <TextBlock x:Name="TotalSpentText" Text="Rp 0" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <ItemsControl x:Name="TransaksiItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Transaksi.Description}" FontWeight="Bold" FontSize="15" />
                                            <TextBlock Text="{Binding Transaksi.Date, StringFormat='dd MMM yyyy, HH:mm'}" FontSize="12" Foreground="{StaticResource TextGray}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Transaksi, Converter={StaticResource Sign}}"
                                                       Foreground="{Binding Transaksi, Converter={StaticResource SignColor}}"
                                                       FontWeight="Bold" FontSize="16" />
                                            <TextBlock Text="{Binding TagihanName}" FontSize="12" Foreground="{StaticResource TextGray}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Per-student view: tagihan details on the left, what this student paid on the right  -->
                    <ItemsControl x:Name="TagihanPaymentItems" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Left: tagihan details and new payment data  -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tagihan.Name}" FontWeight="Bold" FontSize="15" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,3,0,4">
                                                <Run Text="{Binding Tagihan.CreatedDate, StringFormat='dd MMM yyyy'}" />
                                                <Run Text=" &#8226; " />
                                                <Run Text="{Binding Tagihan.Amount, Converter={StaticResource Rupiah}}" />
                                            </TextBlock>

                                            <!-- New Data: Sisa and Dibayar -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextGray}">
                                                    <Run Text="Sisa: "/>
                                                    <Run Text="{Binding AmountDue, Converter={StaticResource Rupiah}}"/>
                                                    <Run Text=" (Dibayar: "/>
                                                    <Run Text="{Binding AmountPaid, Converter={StaticResource Rupiah}}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- New Data: Status -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Status: " FontSize="11" Foreground="{StaticResource TextGray}" />
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                           FontSize="11" FontWeight="Bold" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  Right: Checkmark if Lunas  -->
                                        <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="#2E7D32"
                                                VerticalAlignment="Center" ToolTip="Lunas"
                                                Visibility="{Binding IsLunas, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="&#10003;" Foreground="White" FontSize="13" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyText" Text="Belum ada transaksi." Foreground="{StaticResource TextGray}"
                               HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Page>
