<Page x:Class="ClassFinance.Views.RiwayatTransaksiPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:ClassFinance.Converters"
      xmlns:services="clr-namespace:ClassFinance.Services"
      xmlns:behaviors="clr-namespace:ClassFinance.Behaviors" TextElement.Foreground="{DynamicResource TextDark}"
      Title="Riwayat Transaksi" Background="{DynamicResource PageBackground}">
    <Page.Resources>
        <conv:TransaksiSignConverter x:Key="Sign" />
        <conv:TransaksiColorConverter x:Key="SignColor" />
        <conv:RupiahConverter x:Key="Rupiah" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <conv:HasTransactionDateConverter x:Key="TransactionDateHighlight" />
        <conv:CalendarMonthStateConverter x:Key="CalendarMonthState" />
        <Style x:Key="TransactionTableCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Effect" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryCalendarMonthButtonStyle" TargetType="CalendarButton"
               BasedOn="{StaticResource CalendarMonthButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Value="Selected">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource CalendarMonthState}">
                            <Binding Path="DataContext" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="DisplayDate" RelativeSource="{RelativeSource AncestorType={x:Type Calendar}}" />
                            <Binding Path="SelectedDate" RelativeSource="{RelativeSource AncestorType={x:Type Calendar}}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource CalendarSelectedMonthBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource CalendarSelectedMonthForeground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CalendarSelectedMonthBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryCalendarDayButtonStyle" TargetType="CalendarDayButton"
               BasedOn="{StaticResource CalendarDayButtonBaseStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource TransactionDateHighlight}">
                            <Binding />
                            <Binding Source="{x:Static services:DataStore.Instance}" Path="TransactionRevision" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource TransactionDateBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource TransactionDateForeground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TransactionDateBorder}" />
                    <Setter Property="BorderThickness" Value="1" />
                </DataTrigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CalendarSelectedMonthBackground}" />
                    <Setter Property="Foreground" Value="{DynamicResource CalendarSelectedMonthForeground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CalendarSelectedMonthBorder}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryCalendarStyle" TargetType="Calendar" BasedOn="{StaticResource CalendarBaseStyle}">
            <Setter Property="CalendarDayButtonStyle" Value="{StaticResource HistoryCalendarDayButtonStyle}" />
            <Setter Property="CalendarButtonStyle" Value="{StaticResource HistoryCalendarMonthButtonStyle}" />
        </Style>
    </Page.Resources>

    <DockPanel Margin="32,28,32,28">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="24" VerticalAlignment="Center" ><Run Text="R"/><Run Language="en-id" Text="iwayat"/><Run Text=" T"/><Run Language="en-id" Text="ransaksi"/></TextBlock>

            <ComboBox x:Name="FilterCombo" Grid.Column="2" Width="160" Margin="0,0,12,0" VerticalAlignment="Center"
                      Style="{StaticResource RoundedComboBox}" SelectedIndex="0" >
                <ComboBoxItem Content="Semua" />
                <ComboBoxItem Content="Kas Masuk" />
                <ComboBoxItem Content="Kas Keluar" />
            </ComboBox>

            <Button x:Name="TambahButton" Grid.Column="3" Content="+ Tambah Transaksi"
                    Style="{StaticResource PrimaryButton}" Click="TambahButton_Click" />
        </Grid>

        <StackPanel x:Name="DateFilterPanel" DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="Tanggal" VerticalAlignment="Center" Foreground="{DynamicResource TextGray}" Margin="0,0,8,0" />
            <DatePicker x:Name="DateFilterPicker" Width="190" Height="42" Margin="0,0,12,0"
                        CalendarStyle="{StaticResource HistoryCalendarStyle}"
                        SelectedDateChanged="DateFilter_Changed" />
            <Button Content="Reset Filter" Style="{StaticResource ThemeActionButton}" Padding="12,8"
                    Click="ClearDateFilter_Click" />
        </StackPanel>

        <TextBlock x:Name="SummaryScopeText" DockPanel.Dock="Top"
                   Text="Kas masuk dan keluar mengikuti filter tanggal dan jenis. Saldo kas menunjukkan posisi saat ini."
                   Foreground="{DynamicResource TextGray}" FontSize="12" Margin="0,0,0,12" />

        <Grid x:Name="SummaryRow" DockPanel.Dock="Top" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" behaviors:HoverLiftBehavior.IsEnabled="True"
                    CornerRadius="16" Padding="20">
                <Grid Margin="-20">
                    <Border CornerRadius="16" Background="{DynamicResource CashFlowIncomeFill}" IsHitTestVisible="False">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0.15,1">
                                <GradientStop Color="#FF000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="0.95" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                    <StackPanel Margin="20">
                        <TextBlock Text="Saldo Kas Saat Ini" Foreground="{DynamicResource TextGray}" FontSize="13" FontWeight="Medium" />
                        <TextBlock x:Name="TotalKasText" Text="Rp 0" Foreground="{DynamicResource TextDark}" FontSize="24"
                                   FontWeight="Medium" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" behaviors:HoverLiftBehavior.IsEnabled="True">
                <StackPanel>
                    <TextBlock Text="Kas Masuk" Foreground="{DynamicResource TextGray}" FontSize="13" FontWeight="Medium" />
                    <TextBlock x:Name="TotalEarnedText" Text="Rp 0" FontSize="24" FontWeight="Medium"
                               Foreground="{DynamicResource AccentText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" behaviors:HoverLiftBehavior.IsEnabled="True">
                <Grid Margin="-20">
                    <Border CornerRadius="14" Background="{DynamicResource CashFlowExpenseFill}" IsHitTestVisible="False">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0.15,1">
                                <GradientStop Color="#FF000000" Offset="0" />
                                <GradientStop Color="#00000000" Offset="0.95" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>
                    <StackPanel Margin="20">
                        <TextBlock Text="Kas Keluar" Foreground="{DynamicResource TextGray}" FontSize="13" FontWeight="Medium" />
                        <TextBlock x:Name="TotalSpentText" Text="Rp 0" FontSize="24" FontWeight="Medium"
                                   Foreground="{DynamicResource TextDark}" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="StudentBillTotals" DockPanel.Dock="Top" Margin="0,0,0,20" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="TotalOwedCard" Grid.Column="0" Style="{StaticResource Card}"
                    CornerRadius="16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Total Tagihan Belum Dibayar" Foreground="{DynamicResource TextGray}" FontSize="13" />
                    <TextBlock x:Name="TotalOwedText" Text="Rp 0" Foreground="{DynamicResource StatusRed}"
                               FontSize="26" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="TotalPaidCard" Grid.Column="2" Style="{StaticResource Card}" CornerRadius="16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Total Dibayar" Foreground="{DynamicResource TextGray}" FontSize="13" />
                    <TextBlock x:Name="TotalPaidText" Text="Rp 0" Foreground="{DynamicResource IncomeColor}"
                               FontSize="26" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource TransactionTableCard}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <Grid x:Name="TransactionListHeader" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="132" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tanggal" FontSize="10" Foreground="{DynamicResource TextGray}" />
                        <TextBlock Grid.Column="1" Text="Keterangan" FontSize="10" Foreground="{DynamicResource TextGray}" />
                        <TextBlock Grid.Column="2" Text="Jenis" FontSize="10" Foreground="{DynamicResource TextGray}" />
                        <TextBlock Grid.Column="3" Text="Jumlah" FontSize="10" Foreground="{DynamicResource TextGray}"
                                   TextAlignment="Right" />
                    </Grid>
                    <Border x:Name="TransactionHeaderSeparator" Height="1" Background="{DynamicResource BorderColor}"
                            Margin="0,0,0,4" />

                    <Grid x:Name="TagihanPaymentHeader" Margin="0,0,0,4" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tanggal" FontSize="10" Foreground="{DynamicResource TextGray}" />
                        <TextBlock Grid.Column="1" Text="Tagihan" FontSize="10" Foreground="{DynamicResource TextGray}" />
                        <TextBlock Grid.Column="2" Text="Status" FontSize="10" Foreground="{DynamicResource TextGray}" />
                        <TextBlock Grid.Column="3" Text="Sisa" FontSize="10" Foreground="{DynamicResource TextGray}"
                                   TextAlignment="Right" />
                    </Grid>
                    <Border x:Name="TagihanPaymentHeaderSeparator" Height="1" Background="{DynamicResource BorderColor}"
                            Margin="0,0,0,4" Visibility="Collapsed" />

                    <ItemsControl x:Name="TransaksiItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="44">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{DynamicResource TextDark}" />
                                        <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DescriptionText}" FontSize="11" Foreground="{DynamicResource TextDark}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PaymentMethodText}" FontSize="10" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding RefundStatus}" FontSize="10" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding Transaksi.IsPendingRefund}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusAmber}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding TagihanName}" FontSize="10" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" FontSize="10"
                                               Foreground="{Binding Transaksi, Converter={StaticResource SignColor}}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Transaksi, Converter={StaticResource Sign}}"
                                               Foreground="{Binding Transaksi, Converter={StaticResource SignColor}}"
                                               FontSize="11" TextAlignment="Right" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <Button Content="•••" Style="{StaticResource OverflowDotsButton}"
                                                ToolTip="Aksi transaksi lainnya"
                                                AutomationProperties.Name="Aksi transaksi"
                                                AutomationProperties.HelpText="Buka menu untuk melihat tindakan yang tersedia untuk transaksi ini."
                                                Visibility="{Binding CanShowActions, Converter={StaticResource BoolToVis}}"
                                                PreviewMouseDown="TransactionMenuButton_PreviewMouseDown"
                                                Click="ShowTransactionActions_Click" />
                                        <Button Content="Selesaikan Refund" Tag="{Binding Transaksi}"
                                                Style="{StaticResource SmallWarningActionButton}" Margin="8,0,0,0"
                                                ToolTip="Saldo kas akan berkurang sebesar nominal refund dan status menjadi Lunas."
                                                AutomationProperties.Name="Selesaikan Refund"
                                                Visibility="{Binding CanMarkRefundPaid, Converter={StaticResource BoolToVis}}"
                                                Click="MarkRefundPaid_Click" />
                                    </StackPanel>
                                    <Border Grid.ColumnSpan="5" Height="1" Background="{DynamicResource BorderColor}"
                                            VerticalAlignment="Bottom" Opacity="0.65" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl x:Name="TagihanPaymentItems" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="40" Background="Transparent" Cursor="Hand" Tag="{Binding Tagihan}"
                                      MouseLeftButtonUp="TagihanPaymentRow_Click" ToolTip="Klik untuk membuka tagihan ini">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Tagihan.CreatedDate, StringFormat='dd MMM yyyy'}"
                                               FontSize="11" Foreground="{DynamicResource TextGray}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Tagihan.Name}" FontSize="11" Foreground="{DynamicResource TextDark}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="10" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0">
                                            <Run Text="Total " />
                                            <Run Text="{Binding Tagihan.Amount, Converter={StaticResource Rupiah}}" />
                                            <Run Text=" · Dibayar " />
                                            <Run Text="{Binding AmountPaid, Converter={StaticResource Rupiah}}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Status}"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                               FontSize="10" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding AmountDue, Converter={StaticResource Rupiah}}"
                                               FontSize="11" Foreground="{DynamicResource TextDark}"
                                               TextAlignment="Right" VerticalAlignment="Center" />
                                    <Border Grid.ColumnSpan="4" Height="1" Background="{DynamicResource BorderColor}"
                                            VerticalAlignment="Bottom" Opacity="0.65" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="EmptyText" Text="Belum ada transaksi." Foreground="{DynamicResource TextGray}"
                               HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Page>
