<Page x:Class="ClassFinance.Views.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TextElement.Foreground="{DynamicResource TextDark}"
      Title="Masuk" Background="{DynamicResource PageBackground}">
    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
                Background="{DynamicResource SurfaceBackground}" CornerRadius="18">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" Opacity="0.15" ShadowDepth="4" Color="Black" />
            </Border.Effect>
            <StackPanel>
                <!--  Red hero header  -->
                <Border Background="{StaticResource PrimaryRed}" CornerRadius="18,18,60,60" Padding="0,36,0,36">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="110" Height="110" ClipToBounds="True" HorizontalAlignment="Center">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,110,110" RadiusX="20.5" RadiusY="20.5" />
                            </Border.Clip>
                            <Image Source="/Assets/kasmate-logo.jpeg" Width="154" Height="154" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Selamat Datang Kembali" Foreground="White" FontSize="24"
                                   HorizontalAlignment="Center" Margin="0,16,0,4" />
                        <TextBlock Text="Masuk ke KasMate" Foreground="White" FontSize="13"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <StackPanel Margin="36,32,36,32">
                    <TextBlock Text="Nama Pengguna" FontSize="12" Foreground="{DynamicResource TextGray}" Margin="4,0,0,6" />
                    <Border Height="44" Margin="0,0,0,16" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="22">
                        <TextBox x:Name="UsernameBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextDark}" CaretBrush="{DynamicResource TextDark}"
                                 FontSize="14" Padding="14,0" VerticalContentAlignment="Center" />
                    </Border>

                    <TextBlock Text="Kata Sandi" FontSize="12" Foreground="{DynamicResource TextGray}" Margin="4,0,0,6" />
                    <Border Height="44" Margin="0,0,0,10" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="22">
                        <Grid>
                            <PasswordBox x:Name="PasswordBoxInput" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextDark}" CaretBrush="{DynamicResource TextDark}"
                                         FontSize="14"
                                         Padding="14,0,48,0" VerticalContentAlignment="Center" />
                            <TextBox x:Name="VisiblePasswordBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextDark}" FontSize="14"
                                     Padding="14,0,48,0" VerticalContentAlignment="Center" Visibility="Collapsed" />
                            <Button x:Name="TogglePasswordVisibilityButton" Width="38" Height="38"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                    Background="Transparent" BorderThickness="0" Padding="8"
                                    Cursor="Hand" Focusable="True" FocusVisualStyle="{StaticResource ThemeFocusVisual}"
                                    ToolTip="Tampilkan kata sandi" PreviewMouseLeftButtonDown="TogglePasswordVisibility_MouseDown"
                                    PreviewKeyDown="TogglePasswordVisibility_KeyDown">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="18">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid Width="20" Height="20">
                                    <Path Data="M 12,5 C 7,5 3.2,8 1.5,12 C 3.2,16 7,19 12,19 C 17,19 20.8,16 22.5,12 C 20.8,8 17,5 12,5 Z"
                                          Stroke="{DynamicResource TextGray}" StrokeThickness="1.8" Stretch="Uniform" />
                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource TextGray}" HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                    <Path x:Name="PasswordHiddenSlash" Data="M 3,3 L 21,21" Stroke="{DynamicResource TextGray}"
                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Stretch="Uniform" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AccentText}" FontSize="12"
                               Margin="4,0,0,12" Visibility="Collapsed" TextWrapping="Wrap" />

                    <Button Content="Masuk" Style="{StaticResource PrimaryButton}" Click="LoginButton_Click" Margin="0,6,0,4" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
