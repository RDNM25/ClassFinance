<Page x:Class="ClassFinance.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:ClassFinance.Converters"
      Title="Dashboard" Background="{StaticResource AppBackground}" Width="762">
    <Page.Resources>
        <conv:RupiahConverter x:Key="Rupiah" />
        <conv:TransaksiSignConverter x:Key="Sign" />
        <conv:TransaksiColorConverter x:Key="SignColor" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

            <!--  Header  -->
            <StackPanel Margin="0,0,0,22">
                <TextBlock x:Name="TitleText" Text="UANG KAS" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextDark}" />
                <TextBlock x:Name="SubtitleText" Text="Selamat datang kembali!" FontSize="14" Foreground="{StaticResource TextGray}" Margin="0,4,0,0" />
            </StackPanel>

            <!--  Summary cards row  -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Total Saldo (big, red)  -->
                <Border Grid.Column="0" Background="{StaticResource PrimaryRed}" CornerRadius="16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Total Saldo" Foreground="#FFE0E0" FontSize="13" />
                        <TextBlock x:Name="SaldoText" Text="Rp 0" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,6,0,16" />
                        <Button x:Name="TarikKasButton" Content="TARIK KAS" HorizontalAlignment="Left"
                           Style="{StaticResource PopButton}" Click="TarikKasButton_Click" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Total Siswa" Foreground="{StaticResource TextGray}" FontSize="13" />
                        <TextBlock x:Name="TotalSiswaText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextDark}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Tagihan Belum Lunas" Foreground="{StaticResource TextGray}" FontSize="13" />
                        <TextBlock x:Name="BelumLunasText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource PrimaryRed}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Two column: Data Siswa | Transaksi Terbaru  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Data Siswa  -->
                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DATA SISWA" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            <Button x:Name="TambahSiswaButton" Grid.Column="1" Content="+ TAMBAH SISWA"
                                    Style="{StaticResource SmallOutlineButton}" Click="TambahSiswaButton_Click" />
                        </Grid>

                        <ItemsControl x:Name="SiswaItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Text="{Binding Nis, StringFormat='NIS: {0}'}" FontSize="11" Foreground="{StaticResource TextGray}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalDibayar, Converter={StaticResource Rupiah}}"
                                                       FontWeight="Bold" Foreground="{StaticResource PrimaryRed}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoSiswaText" Text="Belum ada siswa terdaftar." Foreground="{StaticResource TextGray}"
                                   FontSize="13" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!--  Transaksi Terbaru  -->
                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TRANSAKSI TERBARU" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            <Button x:Name="LihatSemuaButton" Grid.Column="1" Content="Lihat semua &#8594;"
                                    Style="{StaticResource SmallOutlineButton}"
                                    FontWeight="Bold" Cursor="Hand" Click="LihatSemuaButton_Click" />
                        </Grid>

                        <ItemsControl x:Name="TransaksiItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Description}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Text="{Binding Date, StringFormat='dd MMM yyyy, HH:mm'}" FontSize="11" Foreground="{StaticResource TextGray}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource Sign}}"
                                                       Foreground="{Binding Converter={StaticResource SignColor}}"
                                                       FontWeight="Bold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoTransaksiText" Text="Belum ada transaksi." Foreground="{StaticResource TextGray}"
                                   FontSize="13" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
