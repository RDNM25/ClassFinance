<Page x:Class="ClassFinance.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:ClassFinance.Converters" TextElement.Foreground="{DynamicResource TextDark}"
      Title="Dashboard" Background="{DynamicResource AppBackground}" SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <conv:TransaksiSignConverter x:Key="Sign" />
        <conv:TransaksiColorConverter x:Key="SignColor" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ClickableStudentRow" TargetType="Border" BasedOn="{StaticResource ListRow}">
            <Setter Property="Focusable" Value="True" />
            <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="ToolTip" Value="Buka detail riwayat siswa" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryRedLight}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,28,32,28">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

            <!--  Header  -->
            <StackPanel Margin="0,0,0,22">
                <TextBlock x:Name="TitleText" Text="Uang Kas" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextDark}" />
                <TextBlock x:Name="SubtitleText" Text="Selamat datang kembali!" FontSize="14" Foreground="{DynamicResource TextGray}" Margin="0,4,0,0" />
            </StackPanel>

            <!--  Summary cards row  -->
            <Grid x:Name="SummaryCardsGrid" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Total Saldo (big, red)  -->
                <Border x:Name="BalanceCard" Grid.Column="0" Background="{StaticResource PrimaryRed}" CornerRadius="16" Padding="24">
                    <StackPanel>
                        <TextBlock Text="Total Saldo" Foreground="White" FontSize="13" />
                        <TextBlock x:Name="SaldoText" Text="Rp 0" Foreground="White" FontSize="30" FontWeight="Bold" Margin="0,6,0,16" />
                        <Button x:Name="TarikKasButton" Content="Tarik Kas" HorizontalAlignment="Left"
                           Style="{StaticResource ThemeActionButton}" Click="TarikKasButton_Click" />
                    </StackPanel>
                </Border>

                <Border x:Name="StudentCountCard" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Total Siswa" Foreground="{DynamicResource TextGray}" FontSize="13" />
                        <TextBlock x:Name="TotalSiswaText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextDark}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="UnpaidCountCard" Grid.Column="4" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Tagihan Belum Lunas" Foreground="{DynamicResource TextGray}" FontSize="13" />
                        <TextBlock x:Name="BelumLunasText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource AccentText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Two column: Data Siswa | Transaksi Terbaru  -->
            <Grid x:Name="DashboardSectionsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Data Siswa  -->
                <Border x:Name="StudentsCard" Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Data Siswa" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            <Button x:Name="TambahSiswaButton" Grid.Column="1" Content="+ Tambah Siswa"
                                    Style="{StaticResource SmallThemeActionButton}" Click="TambahSiswaButton_Click" />
                        </Grid>

                        <ItemsControl x:Name="SiswaItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ClickableStudentRow}" Cursor="Hand"
                                            MouseLeftButtonUp="SiswaRow_Click" KeyDown="SiswaRow_KeyDown" Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Text="{Binding Nis, StringFormat='NIS: {0}'}" FontSize="12" Foreground="{DynamicResource TextGray}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding UnpaidCount, StringFormat='Belum bayar {0} tagihan'}"
                                                       FontWeight="Bold" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"
                                                       TextWrapping="Wrap" MaxWidth="150" TextAlignment="Right"
                                                       Visibility="{Binding IsRegistered, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Grid.Column="2" Text="›" FontSize="22" Foreground="{DynamicResource TextGray}"
                                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoSiswaText" Text="Belum ada siswa terdaftar." Foreground="{DynamicResource TextGray}"
                                   FontSize="13" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!--  Transaksi Terbaru  -->
                <Border x:Name="RecentTransactionsCard" Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Transaksi Terbaru" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                            <Button x:Name="LihatSemuaButton" Grid.Column="1" Content="Lihat semua &#8594;"
                                    Style="{StaticResource SmallThemeActionButton}"
                                    FontWeight="Bold" Cursor="Hand" Click="LihatSemuaButton_Click" />
                        </Grid>

                        <ItemsControl x:Name="TransaksiItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRow}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Description}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Text="{Binding Date, StringFormat='dd MMM yyyy, HH:mm'}" FontSize="12" Foreground="{DynamicResource TextGray}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource Sign}}"
                                                       Foreground="{Binding Converter={StaticResource SignColor}}"
                                                       FontWeight="Bold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoTransaksiText" Text="Belum ada transaksi." Foreground="{DynamicResource TextGray}"
                                   FontSize="13" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
