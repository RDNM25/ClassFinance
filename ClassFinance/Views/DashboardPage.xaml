<Page x:Class="ClassFinance.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:ClassFinance.Converters"
      xmlns:behaviors="clr-namespace:ClassFinance.Behaviors"
      Title="Ringkasan" Background="{DynamicResource AppBackground}"
      TextElement.Foreground="{DynamicResource TextDark}" SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <Style x:Key="PanelCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Effect" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{x:Null}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource PanelCard}">
            <Setter Property="Height" Value="122" />
            <Setter Property="behaviors:HoverLiftBehavior.IsEnabled" Value="True" />
        </Style>
        <Style x:Key="FollowUpRow" TargetType="Border" BasedOn="{StaticResource ListRow}">
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="Margin" Value="0,4,0,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryRedLight}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentText}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentText}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer x:Name="DashboardScrollViewer" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled" Padding="28,24,28,28">
        <StackPanel x:Name="DashboardContent" MaxWidth="1320" Width="{Binding ViewportWidth, ElementName=DashboardScrollViewer}"
                    HorizontalAlignment="Center">
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="Ringkasan" FontSize="27" Foreground="{DynamicResource TextDark}" />
                    <TextBlock x:Name="SubtitleText" Text="Kondisi kas kelas" FontSize="13" Foreground="{DynamicResource TextGray}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="TarikKasButton" Content="Tarik kas" Style="{StaticResource PrimaryButton}"
                            FontSize="13" Padding="14,9" Margin="0,0,9,0" Click="TarikKasButton_Click" />
                    <Button x:Name="TambahSiswaButton" Content="+ Tambah siswa" Style="{StaticResource ThemeActionButton}"
                            FontSize="13" Padding="14,9" Click="TambahSiswaButton_Click" />
                </StackPanel>
            </Grid>

            <Grid x:Name="SummaryCardsGrid" Width="{Binding ActualWidth, ElementName=DashboardContent}"
                  HorizontalAlignment="Stretch" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="BalanceCard" Grid.Column="0" Style="{StaticResource MetricCard}" VerticalAlignment="Top"
                        Background="{StaticResource PrimaryRed}" BorderBrush="{StaticResource PrimaryRed}">
                    <StackPanel>
                        <TextBlock Text="Kas tersedia" FontSize="13" Foreground="White" />
                        <TextBlock x:Name="SaldoText" Text="Rp 0" FontSize="27" Margin="0,8,0,0" Foreground="White" />
                    </StackPanel>
                </Border>
                <Border x:Name="StudentCountCard" Grid.Column="2" Style="{StaticResource MetricCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Total siswa" FontSize="13" Foreground="{DynamicResource TextGray}" />
                        <TextBlock x:Name="TotalSiswaText" Text="0" FontSize="27" Margin="0,8,0,4" Foreground="{DynamicResource TextDark}" />
                    </StackPanel>
                </Border>
                <Border x:Name="UnpaidCountCard" Grid.Column="4" Style="{StaticResource MetricCard}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Tagihan belum lunas" FontSize="13" Foreground="{DynamicResource TextGray}" />
                        <TextBlock x:Name="BelumLunasText" Text="Rp 0" FontSize="27" Margin="0,8,0,4" Foreground="{DynamicResource StatusRed}" />
                        <TextBlock x:Name="UnpaidCaptionText" Text="Sisa pembayaran siswa" FontSize="11" Foreground="{DynamicResource TextGray}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="AnalyticsGrid" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.1*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="CashFlowCard" Grid.Column="0" Style="{StaticResource PanelCard}" Padding="20,18">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Arus kas" FontSize="17" Foreground="{DynamicResource TextDark}" />
                                <TextBlock x:Name="CashFlowSubtitleText" Text="Pemasukan dan pengeluaran, 6 bulan terakhir" FontSize="11"
                                           Foreground="{DynamicResource TextGray}" Margin="0,3,0,0" />
                            </StackPanel>
                            <ComboBox x:Name="CashFlowPeriodCombo" Grid.Column="1" Width="116" Height="32" FontSize="10"
                                      Padding="14,4,28,4" Style="{StaticResource RoundedComboBox}" SelectedIndex="0"
                                      SelectionChanged="CashFlowPeriodCombo_SelectionChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="6 bulan" Tag="Months" />
                                <ComboBoxItem Content="6 minggu" Tag="Weeks" />
                            </ComboBox>
                        </Grid>
                        <Grid Height="220">
                            <Canvas x:Name="CashFlowCanvas" Background="Transparent"
                                    SizeChanged="CashFlowCanvas_SizeChanged"
                                    MouseMove="CashFlowCanvas_MouseMove" MouseLeave="CashFlowCanvas_MouseLeave">
                                <Border x:Name="CashFlowPointTooltip" Canvas.Left="0" Canvas.Top="0" Panel.ZIndex="100"
                                        Background="{DynamicResource ElevatedCardBackground}" BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1" CornerRadius="8" Padding="10,7" MaxWidth="220"
                                        Visibility="Collapsed" IsHitTestVisible="False">
                                    <StackPanel>
                                        <TextBlock x:Name="CashFlowPointLabel" FontSize="10" Foreground="{DynamicResource TextGray}" />
                                        <TextBlock x:Name="CashFlowPointAmount" FontSize="13" Foreground="{DynamicResource TextDark}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </Canvas>
                            <TextBlock x:Name="CashFlowEmptyText" Text="Belum ada transaksi kas dalam 6 bulan terakhir."
                                       Foreground="{DynamicResource TextGray}" FontSize="12" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="270" TextAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource CashFlowPrimaryColor}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Pemasukan" FontSize="11" Foreground="{DynamicResource TextGray}" Margin="0,0,20,0" />
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource CashFlowSecondaryColor}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Pengeluaran" FontSize="11" Foreground="{DynamicResource TextGray}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="RightRail" Grid.Column="2">
                    <Border x:Name="ActiveBillCard" Style="{StaticResource PanelCard}" Padding="17,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="ActiveBillNameText" Text="Belum ada tagihan" FontSize="16" Foreground="{DynamicResource TextDark}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="ActiveBillAmountText" Text="Rp 0" FontSize="21" Foreground="{DynamicResource TextDark}"
                                       Margin="0,8,0,0" Visibility="Collapsed" />
                            <TextBlock x:Name="ActiveBillMetaText" Text="Sisa pembayaran" FontSize="10" Foreground="{DynamicResource TextGray}"
                                       Margin="0,3,0,12" Visibility="Collapsed" />
                            <Button x:Name="ActiveBillOpenButton" Content="Lihat tagihan  →" HorizontalAlignment="Left"
                                    Style="{StaticResource SmallThemeActionLinkButton}" Click="ActiveBillOpenButton_Click"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="StudentsCard" Style="{StaticResource PanelCard}" Padding="17,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Perlu perhatian" FontSize="16" Foreground="{DynamicResource TextDark}" />
                                </StackPanel>
                                <Button x:Name="LihatSiswaButton" Grid.Column="1" Content="Lihat siswa  →" Padding="8,5"
                                        BorderThickness="0"
                                        VerticalAlignment="Top" Style="{StaticResource SmallThemeActionLinkButton}"
                                        Click="LihatSiswaButton_Click" />
                            </Grid>
                            <ItemsControl x:Name="SiswaItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource FollowUpRow}" Cursor="Hand" Focusable="True"
                                                KeyboardNavigation.IsTabStop="True" MouseLeftButtonUp="SiswaRow_Click"
                                                KeyDown="SiswaRow_KeyDown" Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextDark}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Nis, StringFormat='NIS {0}'}" FontSize="10" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding OutstandingText}" FontSize="11" Foreground="{DynamicResource StatusRed}" TextAlignment="Right" />
                                                    <TextBlock Text="{Binding FollowUpLabel}" FontSize="9" Foreground="{DynamicResource TextGray}" Margin="0,2,0,0" TextAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoSiswaText" Text="Semua siswa sudah melunasi tagihan mereka."
                                       Foreground="{DynamicResource TextGray}" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border x:Name="RecentTransactionsCard" Style="{StaticResource PanelCard}" Padding="18,17">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Transaksi terbaru" FontSize="17" Foreground="{DynamicResource TextDark}" />
                            <TextBlock Text="Catatan kas kelas yang terakhir diperbarui" FontSize="11" Foreground="{DynamicResource TextGray}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="TransactionFilterCombo" Width="132" Height="34" FontSize="11"
                                      Style="{StaticResource RoundedComboBox}" SelectedIndex="0"
                                      SelectionChanged="TransactionFilterCombo_SelectionChanged">
                                <ComboBoxItem Content="Semua jenis" Tag="All" />
                                <ComboBoxItem Content="Pemasukan" Tag="Masuk" />
                                <ComboBoxItem Content="Pengeluaran" Tag="Keluar" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="132" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tanggal" FontSize="10" Foreground="{DynamicResource TextGray}" />
                        <TextBlock Grid.Column="1" Text="Keterangan" FontSize="10" Foreground="{DynamicResource TextGray}" />
                        <TextBlock Grid.Column="2" Text="Jenis" FontSize="10" Foreground="{DynamicResource TextGray}" />
                        <TextBlock Grid.Column="3" Text="Jumlah" FontSize="10" Foreground="{DynamicResource TextGray}" TextAlignment="Right" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,4" />

                    <ItemsControl x:Name="TransaksiItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="112" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="132" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{DynamicResource TextGray}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextDark}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding TypeLabel}" FontSize="10" Foreground="{Binding TypeBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding AmountText}" FontSize="11" Foreground="{Binding AmountBrush}"
                                               TextAlignment="Right" VerticalAlignment="Center" />
                                    <Border Grid.ColumnSpan="4" Height="1" Background="{DynamicResource BorderColor}"
                                            VerticalAlignment="Bottom" Opacity="0.65" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoTransaksiText" Text="Belum ada transaksi untuk jenis ini."
                               Foreground="{DynamicResource TextGray}" FontSize="11" Margin="0,12,0,4" Visibility="Collapsed" />
                    <Grid Margin="0,12,0,0">
                        <TextBlock x:Name="TransactionCountText" Text="Menampilkan 0 transaksi" FontSize="10"
                                   Foreground="{DynamicResource TextGray}" VerticalAlignment="Center" />
                        <Button x:Name="LihatSemuaButton" Content="Lihat semua transaksi  →" HorizontalAlignment="Right"
                                BorderThickness="0" Style="{StaticResource SmallThemeActionLinkButton}"
                                Click="LihatSemuaButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
