<Page x:Class="ClassFinance.Views.TagihanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:ClassFinance.Converters"
      Title="Tagihan" Background="{StaticResource AppBackground}" Width="973">
    <Page.Resources>
        <conv:RupiahConverter x:Key="Rupiah" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="32,28,32,28" Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <!--  Left: list of tagihan  -->
        <DockPanel Grid.Column="0" Grid.ColumnSpan="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" SharedSizeGroup="TagihanHeaderRow" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TAGIHAN" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="BuatTagihanButton" Content="+ BUAT TAGIHAN"
                        Style="{StaticResource PrimaryButton}" Click="BuatTagihanButton_Click" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Left items control remains standard for listing bills -->
                        <ItemsControl x:Name="TagihanItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRow}" Cursor="Hand" MouseLeftButtonUp="TagihanRow_Click" Tag="{Binding Tagihan}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Tagihan.Name}" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Text="{Binding Tagihan.CreatedDate, StringFormat='dd MMM yyyy'}"
                                                           FontSize="12" Foreground="{StaticResource TextGray}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Tagihan.Amount, Converter={StaticResource Rupiah}}"
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Border Grid.Column="2" Width="24" Height="24" CornerRadius="12" Background="#2E7D32"
                                                    VerticalAlignment="Center" ToolTip="Lunas &#8212; semua siswa sudah bayar"
                                                    Visibility="{Binding IsFullyPaid, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#10003;" Foreground="White" FontSize="13" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyText" Text="Belum ada tagihan." Foreground="{StaticResource TextGray}"
                                   HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!--  Right: detail of selected tagihan  -->
        <DockPanel Grid.Column="2" Margin="30,0,10,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" SharedSizeGroup="TagihanHeaderRow" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="DetailTitle" Text="status pembayaran"
                           FontSize="16" FontWeight="Bold" VerticalAlignment="Top" TextWrapping="Wrap" Margin="27,19,18,0" TextAlignment="Right" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Right items control updated with student details, partial payments, and buttons -->
                    <ItemsControl x:Name="DetailItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SiswaName}" FontWeight="Bold" FontSize="14" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextGray}" Margin="0,2,0,0">
                                                <Run Text="Sisa: Rp "/>
                                                <Run Text="{Binding Entry.AmountDue, Converter={StaticResource Rupiah}}"/>
                                                <Run Text=" (Dibayar: Rp "/>
                                                <Run Text="{Binding Entry.JumlahDibayar, Converter={StaticResource Rupiah}}"/>
                                                <Run Text=")"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Entry.Status}" Foreground="{Binding Entry.Status, Converter={StaticResource StatusBrush}}"
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />

                                        <Button Grid.Column="2" Content="Tandai Lunas" Style="{StaticResource SmallOutlineButton}"
                                                Tag="{Binding}" Click="TandaiLunas_Click" Margin="0,0,6,0" />

                                        <Button Grid.Column="3" Content="Bayar Manual" Style="{StaticResource SmallOutlineButton}"
                                                Tag="{Binding}" Click="BayarManual_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</Page>