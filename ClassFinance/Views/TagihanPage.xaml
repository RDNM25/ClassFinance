<Page x:Class="ClassFinance.Views.TagihanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:ClassFinance.Converters"
      Title="Tagihan" Background="{StaticResource AppBackground}">
    <Page.Resources>
        <conv:RupiahConverter x:Key="Rupiah" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
    </Page.Resources>

    <Grid Margin="32,28,32,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <!--  Left: list of tagihan  -->
        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TAGIHAN" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <Button x:Name="BuatTagihanButton" Grid.Column="1" Content="+ BUAT TAGIHAN"
                        Style="{StaticResource PrimaryButton}" Click="BuatTagihanButton_Click" />
            </Grid>

            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl x:Name="TagihanItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListRow}" Cursor="Hand" MouseLeftButtonUp="TagihanRow_Click" Tag="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Text="{Binding DueDate, StringFormat='Jatuh tempo: dd MMM yyyy'}" FontSize="12" Foreground="{StaticResource TextGray}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Amount, Converter={StaticResource Rupiah}}"
                                                       FontWeight="Bold" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyText" Text="Belum ada tagihan." Foreground="{StaticResource TextGray}"
                                   HorizontalAlignment="Center" Margin="0,30,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <!--  Right: detail of selected tagihan  -->
        <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" x:Name="DetailTitle" Text="Pilih tagihan untuk melihat status pembayaran"
                       FontSize="16" FontWeight="Bold" Margin="0,0,0,20" TextWrapping="Wrap" />

            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="DetailItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding SiswaName}" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Entry.Status}" Foreground="{Binding Entry.Status, Converter={StaticResource StatusBrush}}"
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Button Grid.Column="2" Content="Tandai Lunas" Style="{StaticResource SmallOutlineButton}"
                                                Tag="{Binding}" Click="TandaiLunas_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Grid>
</Page>
