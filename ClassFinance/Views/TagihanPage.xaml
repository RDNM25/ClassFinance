<Page x:Class="ClassFinance.Views.TagihanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:conv="clr-namespace:ClassFinance.Converters" TextElement.Foreground="{DynamicResource TextDark}"
      xmlns:behaviors="clr-namespace:ClassFinance.Behaviors"
      Title="Tagihan" Background="{DynamicResource PageBackground}" SizeChanged="Page_SizeChanged">
    <Page.Resources>
        <conv:RupiahConverter x:Key="Rupiah" />
        <conv:StatusToBrushConverter x:Key="StatusBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="HistoryExpanderHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextGray}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ThemeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="18" Height="18" CornerRadius="9"
                                    Background="{DynamicResource TextDark}" VerticalAlignment="Center">
                                <Path Width="12" Height="12" Stretch="None" Data="M 3,4 L 6,8 L 9,4"
                                      Stroke="{DynamicResource SurfaceBackground}"
                                      StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="ArrowRotation" Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" RecognizesAccessKey="True"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotation"
                                                             Storyboard.TargetProperty="Angle" To="180"
                                                             Duration="0:0:0.18" AccelerationRatio="0.2" DecelerationRatio="0.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArrowRotation"
                                                             Storyboard.TargetProperty="Angle" To="0"
                                                             Duration="0:0:0.18" AccelerationRatio="0.2" DecelerationRatio="0.8" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="TransactionHistoryExpanderTemplate" TargetType="Expander">
            <StackPanel>
                <ToggleButton Style="{StaticResource HistoryExpanderHeaderToggleStyle}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" />
                <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsExpanded" Value="True">
                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="TagihanActionButton" TargetType="Button" BasedOn="{StaticResource SmallOutlineButton}">
            <Setter Property="Foreground" Value="{DynamicResource TagihanActionForeground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="actionBorder" Background="{DynamicResource SurfaceBackground}" BorderBrush="{StaticResource PrimaryRed}"
                                BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="hoverOverlay" Background="{DynamicResource ButtonHoverBackground}"
                                        CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity"
                                                             To="0.85" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.11" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TagihanPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource SmallPrimaryButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <SolidColorBrush x:Name="bgBrush" Color="#F43F5E" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bgBrush" Storyboard.TargetProperty="Color"
                                                            To="#F43F5E" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="bgBrush" Storyboard.TargetProperty="Color"
                                                            To="#F43F5E" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledButtonText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TagihanWarningActionButton" TargetType="Button" BasedOn="{StaticResource SmallWarningActionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{DynamicResource SurfaceBackground}"
                                BorderBrush="{DynamicResource StatusAmber}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="hoverOverlay" Background="{DynamicResource ButtonHoverBackground}"
                                        CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                                <Border x:Name="pressedOverlay" Background="{DynamicResource SubtleBackground}"
                                        CornerRadius="7" Opacity="0" IsHitTestVisible="False" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity"
                                                             To="0.85" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="hoverOverlay" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.11" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="pressedOverlay" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource DisabledButtonBackground}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledButtonText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid x:Name="TagihanLayoutGrid" Margin="32,28,32,28" Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="1.2*" />
        </Grid.ColumnDefinitions>

        <DockPanel x:Name="BillListPanel" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" SharedSizeGroup="TagihanHeaderRow" />
                    <RowDefinition Height="Auto" SharedSizeGroup="TagihanWeekRow" />
                    <RowDefinition Height="Auto" SharedSizeGroup="TagihanFilterRow" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Jadwal Tagihan Mingguan" Foreground="{DynamicResource TextDark}"
                           FontSize="24" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="AturJadwalButton" Content="Atur Jadwal"
                        Style="{StaticResource PrimaryButton}" Click="AturJadwalButton_Click" />

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                    <TextBlock x:Name="CurrentWeekText" FontSize="14" Foreground="{DynamicResource TextDark}" />
                    <TextBlock x:Name="ScheduleSummaryText" FontSize="12" Foreground="{DynamicResource TextGray}" Margin="0,3,0,0" />
                </StackPanel>

                <ComboBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" x:Name="TagihanFilterComboBox" Style="{StaticResource RoundedComboBox}"
                          Margin="0,12,0,0" HorizontalAlignment="Left" Width="200"
                          SelectionChanged="TagihanFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Semua Minggu" IsSelected="True" Tag="Semua" />
                    <ComboBoxItem Content="Minggu Ini" Tag="MingguIni" />
                    <ComboBoxItem Content="Belum Lunas" Tag="BelumSelesai" />
                    <ComboBoxItem Content="Sudah Lunas" Tag="Selesai" />
                </ComboBox>
            </Grid>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <ListBox x:Name="TagihanItems" BorderThickness="0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" SelectionChanged="TagihanItems_SelectionChanged"
                             MouseLeftButtonUp="TagihanItems_MouseLeftButtonUp"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True">

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,2"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{StaticResource ThemeFocusVisual}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Cursor="Hand" Background="Transparent" behaviors:HoverLiftBehavior.IsEnabled="False">
                                        <Border x:Name="TagihanRow" Style="{StaticResource ElevatedListRow}" BorderBrush="Transparent"
                                                Margin="0,2,0,4"
                                                behaviors:HoverLiftBehavior.IsEnabled="False" />

                                        <Border x:Name="HoverOverlay" Background="{DynamicResource PrimaryRedLight}"
                                                CornerRadius="12" Margin="{Binding ElementName=TagihanRow, Path=Margin}"
                                                Opacity="0" IsHitTestVisible="False" />

                                        <Border x:Name="SelectionOverlay" Background="{DynamicResource PrimaryRedLight}" BorderBrush="{StaticResource PrimaryRed}"
                                                BorderThickness="1.5" CornerRadius="12" Margin="{Binding ElementName=TagihanRow, Path=Margin}"
                                                Opacity="0" IsHitTestVisible="False" />

                                        <Grid Margin="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PeriodTitle}" Foreground="{DynamicResource TextDark}" FontSize="15" />
                                                <TextBlock Text="{Binding PeriodRange}"
                                                           FontSize="12" Foreground="{DynamicResource TextGray}" Margin="0,3,0,0" />
                                                <TextBlock Text="{Binding PaymentSummary}"
                                                           FontSize="11" Foreground="{DynamicResource TextGray}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding AmountPerStudentLabel}" Foreground="{DynamicResource TextDark}"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding OutstandingLabel}" FontSize="11" Foreground="{DynamicResource TextGray}"
                                                           HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Width="24" Height="24" CornerRadius="12" Background="{DynamicResource StatusGreen}"
                                                    VerticalAlignment="Center" ToolTip="Lunas &#8212; semua siswa sudah bayar"
                                                    Visibility="{Binding IsFullyPaid, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#10003;" Foreground="White" FontSize="13"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <MultiDataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity"
                                                                         To="0.7" Duration="0:0:0.14" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.EnterActions>
                                            <MultiDataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.11" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </MultiDataTrigger.ExitActions>
                                        </MultiDataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="SelectionOverlay" 
                                                                         Storyboard.TargetProperty="Opacity" 
                                                                         To="1" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="SelectionOverlay" 
                                                                         Storyboard.TargetProperty="Opacity" 
                                                                         To="0" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyText" Text="Belum ada tagihan." Foreground="{DynamicResource TextGray}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                               IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </Border>
        </DockPanel>

        <DockPanel x:Name="PaymentDetailsPanel" Grid.Column="2" Margin="30,0,10,0">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" SharedSizeGroup="TagihanHeaderRow" />
                    <RowDefinition Height="Auto" SharedSizeGroup="TagihanWeekRow" />
                    <RowDefinition Height="Auto" SharedSizeGroup="TagihanFilterRow" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <Button x:Name="ShowBillListButton" Content="Daftar minggu"
                            Style="{StaticResource SmallThemeActionButton}" HorizontalAlignment="Left"
                            Click="ShowBillList_Click" Visibility="Collapsed" />
                    <TextBlock x:Name="DetailTitle" Text="Status Pembayaran" Foreground="{DynamicResource TextDark}"
                               FontSize="16" VerticalAlignment="Top" TextWrapping="Wrap" Margin="27,19,18,0" TextAlignment="Right" />
                </StackPanel>
                <Button Grid.Row="0" Grid.Column="1" x:Name="ReminderButton" Content="Kirim Pengingat"
                        Style="{StaticResource SmallPrimaryButton}" VerticalAlignment="Center"
                        Click="KirimPengingat_Click" Visibility="Collapsed" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="SelectedWeekText" FontSize="12"
                           Foreground="{DynamicResource TextGray}" Margin="27,10,0,0" TextAlignment="Right" />

                <ComboBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="StatusFilterComboBox" Style="{StaticResource RoundedComboBox}"
                          Margin="27,12,0,0" HorizontalAlignment="Right" Width="180"
                          Visibility="Collapsed"
                          SelectionChanged="StatusFilterComboBox_SelectionChanged">
                    <ComboBoxItem Content="Semua Status" IsSelected="True" Tag="Semua" />
                    <ComboBoxItem Content="Lunas" Tag="Lunas" />
                    <ComboBoxItem Content="Belum Lunas" Tag="BelumLunas" />
                    <ComboBoxItem Content="Sebagian" Tag="Sebagian" />
                    <ComboBoxItem Content="Proses" Tag="Proses" />
                </ComboBox>
            </Grid>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <TextBlock x:Name="NoSelectedTagihanText"
                               Text="Pilih tagihan untuk melihat status pembayaran."
                               Foreground="{DynamicResource TextGray}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Margin="20" />
                    <TextBlock x:Name="NoMatchingPaymentsText"
                               Text="Tidak ada siswa dengan status ini."
                               Foreground="{DynamicResource TextGray}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" Margin="20" Visibility="Collapsed" />
                    <ScrollViewer x:Name="DetailScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <ItemsControl x:Name="DetailItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ElevatedListRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding SiswaName}" Foreground="{DynamicResource TextDark}" FontSize="14" />

                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                                <TextBlock FontSize="12" Foreground="{DynamicResource TextGray}">
                                                    <Run Text="Sisa: "/>
                                                    <Run Text="{Binding Entry.AmountDue, Converter={StaticResource Rupiah}}"/>
                                                    <Run Text=" (Dibayar: "/>
                                                    <Run Text="{Binding Entry.JumlahDibayar, Converter={StaticResource Rupiah}}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Status: " FontSize="12" Foreground="{DynamicResource TextGray}" />
                                                <TextBlock Text="{Binding Entry.Status}" Foreground="{Binding Entry.Status, Converter={StaticResource StatusBrush}}"
                                                           FontSize="12" />
                                            </StackPanel>

                                            <Expander Margin="0,6,0,0">
                                                <Expander.Style>
                                                    <Style TargetType="Expander">
                                                        <Setter Property="Template" Value="{StaticResource TransactionHistoryExpanderTemplate}" />
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Transactions.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Expander.Style>
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Transactions.Count, StringFormat='Riwayat transaksi ({0})'}"
                                                               FontSize="12" Foreground="{DynamicResource TextGray}" />
                                                </Expander.Header>
                                                <ItemsControl ItemsSource="{Binding Transactions}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SubtleBackground}" CornerRadius="8" Padding="8" Margin="0,2,0,0">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Transaction.Description}" FontSize="12" Foreground="{DynamicResource TextDark}" />
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                            <TextBlock Text="{Binding Transaction.Date, StringFormat='dd MMM yyyy, HH:mm'}" FontSize="10" Foreground="{DynamicResource TextGray}" />
                                                                            <TextBlock Text=" · " FontSize="10" Foreground="{DynamicResource TextGray}" />
                                                                            <TextBlock Text="{Binding PaymentMethodLabel}" FontSize="10" Foreground="{DynamicResource TextGray}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Transaction.Amount, Converter={StaticResource Rupiah}}"
                                                                               Foreground="{DynamicResource TextDark}"
                                                                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                        <Button Content="•••" Style="{StaticResource OverflowDotsButton}"
                                                                                ToolTip="Aksi transaksi lainnya"
                                                                                AutomationProperties.Name="Aksi transaksi pembayaran"
                                                                                AutomationProperties.HelpText="Buka menu untuk melihat tindakan yang tersedia untuk transaksi pembayaran ini."
                                                                                Visibility="{Binding CanShowActions, Converter={StaticResource BoolToVis}}"
                                                                                PreviewMouseDown="ActionMenuButton_PreviewMouseDown"
                                                                                Click="ShowPaymentActions_Click" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <Button Content="Selesaikan Refund" Style="{StaticResource TagihanWarningActionButton}"
                                                    Tag="{Binding}" Click="TandaiRefundLunas_Click" Margin="0,0,0,6" Width="142"
                                                    ToolTip="Saldo kas akan berkurang dan status refund menjadi Lunas."
                                                    AutomationProperties.Name="Selesaikan Refund"
                                                    Visibility="{Binding HasPendingRefund, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Bayar Sisa" Style="{StaticResource TagihanPrimaryActionButton}"
                                                    Tag="{Binding}" Click="TandaiLunas_Click" Margin="0,0,0,6" Width="110"
                                                    ToolTip="Catat sisa tagihan sebagai pembayaran tunai dan tambahkan ke kas."
                                                    AutomationProperties.Name="Bayar sisa tagihan"
                                                    Visibility="{Binding CanMakePayment, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Input Nominal" Style="{StaticResource TagihanActionButton}"
                                                    Tag="{Binding}" Click="BayarManual_Click" Width="110"
                                                    ToolTip="Masukkan nominal pembayaran, termasuk pembayaran sebagian."
                                                    AutomationProperties.Name="Input nominal pembayaran"
                                                    Visibility="{Binding CanMakePayment, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </DockPanel>
    </Grid>
</Page>
