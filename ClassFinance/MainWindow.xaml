<Window x:Class="ClassFinance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Class Finance" Height="750" Width="1200" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{StaticResource AppBackground}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar (shown after login)  -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{StaticResource SidebarBackground}" Visibility="Collapsed">
            <DockPanel LastChildFill="True" Margin="0,20,0,20">
                <StackPanel DockPanel.Dock="Top">
                    <Border Background="White" Width="52" Height="52" CornerRadius="14" Margin="20,0,0,10" HorizontalAlignment="Left">
                        <TextBlock Text="CF" FontWeight="Bold" FontSize="18" Foreground="{StaticResource PrimaryRed}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CLASS FINANCE" Foreground="White" FontWeight="Bold" FontSize="15" Margin="20,4,0,2" />
                    <TextBlock x:Name="SidebarUserText" Text="" Foreground="#FFCDD2" FontSize="12" Margin="20,0,0,20" />

                    <StackPanel x:Name="NavPanel" Margin="0,10,0,0" />
                </StackPanel>

                <Button x:Name="LogoutButton" DockPanel.Dock="Bottom" Style="{StaticResource SidebarButton}"
                        Content="⎋  Logout" Click="LogoutButton_Click" Margin="8,0,8,0" />
            </DockPanel>
        </Border>

        <!--  Content  -->
        <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Background="{StaticResource AppBackground}" />

        <!--  Modal overlay: dialogs render here, inside the main window, instead of as separate OS windows  -->
        <Border x:Name="ModalOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#99000000"
                Visibility="Collapsed" MouseLeftButtonDown="ModalOverlay_MouseLeftButtonDown">
            <Border Background="White" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="460" Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Opacity="0.3" ShadowDepth="6" Color="Black" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                    <ContentControl x:Name="ModalHost" />
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>
