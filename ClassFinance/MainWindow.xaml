<Window x:Class="ClassFinance.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KasMate" Icon="/Assets/kasmate-logo.jpeg" Height="850" Width="1360" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text"
        TextElement.Foreground="{DynamicResource TextDark}"
        Background="{DynamicResource PageBackground}"
        PreviewMouseDown="MainWindow_PreviewMouseDown"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ShellTopBarButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ElevatedCardBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ThemeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="buttonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="buttonSurface" Property="Background" Value="{DynamicResource ElevatedCardBackground}" />
                                <Setter TargetName="buttonSurface" Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="buttonSurface" Property="Background" Value="{DynamicResource PrimaryRedLight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ShellMenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextDark}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ThemeFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="menuSurface" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="menuSurface" Property="Background" Value="{DynamicResource ElevatedCardBackground}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="menuSurface" Property="Background" Value="{DynamicResource PrimaryRedLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Sidebar (shown after login)  -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0" Visibility="Collapsed">
            <DockPanel LastChildFill="False" Margin="0,20,0,20">
                <StackPanel DockPanel.Dock="Top">
                    <Border Width="100" Height="100" ClipToBounds="True" Margin="20,0,0,10" HorizontalAlignment="Left">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,100,100" RadiusX="19" RadiusY="19" />
                        </Border.Clip>
                        <Image Source="/Assets/kasmate-logo.jpeg" Width="140" Height="140" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="KasMate" Foreground="White" FontSize="15" Margin="20,4,0,2" />
                    <TextBlock x:Name="SidebarUserText" Text="" Foreground="White" FontSize="12" Margin="20,0,0,20" />

                    <StackPanel x:Name="NavPanel" Margin="0,10,0,0" />
                </StackPanel>

            </DockPanel>
        </Border>

        <!--  Content  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TopBarBorder" Grid.Row="0" Height="56" Panel.ZIndex="1"
                    Background="{DynamicResource SurfaceBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                    Padding="18,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource ElevatedCardBackground}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" CornerRadius="10" Padding="11,6" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="M4,5 L20,5 L20,20 L4,20 Z M8,3 L8,7 M16,3 L16,7 M4,9 L20,9"
                                  Stroke="{DynamicResource AccentText}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" Fill="Transparent" Width="16" Height="16"
                                  Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock x:Name="TopBarDateText" Text="Rabu, 4 Nov 2026" FontSize="10" FontWeight="Medium"
                                       Foreground="{DynamicResource TextDark}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NotificationButton" Width="40" Height="40" Padding="0"
                                Style="{StaticResource ShellTopBarButton}" Click="NotificationButton_Click"
                                ToolTip="Notifikasi siswa" AutomationProperties.Name="Notifikasi siswa">
                            <Grid Width="20" Height="20">
                                <Path Data="M12,3 C8.7,3 6,5.7 6,9 L6,12 C6,14 4.7,15.6 3.6,16.6 L3.6,17 L20.4,17 L20.4,16.6 C19.3,15.6 18,14 18,12 L18,9 C18,5.7 15.3,3 12,3 Z M10,20 C10.5,21 13.5,21 14,20"
                                      Stroke="{DynamicResource TextDark}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" Fill="Transparent" Stretch="Uniform" />
                                <Ellipse x:Name="NotificationBadge" Width="7" Height="7" Fill="{DynamicResource PrimaryRed}"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                                         Stroke="{DynamicResource ElevatedCardBackground}" StrokeThickness="1" Visibility="Collapsed" />
                            </Grid>
                        </Button>

                        <Button x:Name="ProfileButton" Margin="8,0,0,0" MinWidth="154" Height="42"
                                Padding="5,4" Style="{StaticResource ShellTopBarButton}"
                                Click="ProfileButton_Click" ToolTip="Menu akun" AutomationProperties.Name="Menu akun">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                </Grid.ColumnDefinitions>
                                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource PrimaryRed}"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TopBarProfileInitialsText" Text="AB" FontSize="9" FontWeight="Medium"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,3,0">
                                    <TextBlock x:Name="TopBarProfileNameText" Text="Arung" FontSize="10" FontWeight="Medium"
                                               Foreground="{DynamicResource TextDark}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TopBarProfileRoleText" Text="Bendahara" FontSize="8"
                                               Foreground="{DynamicResource TextGray}" Margin="0,1,0,0" />
                                </StackPanel>
                                <Path Grid.Column="2" Data="M4,7 L8,11 L12,7" Stroke="{DynamicResource TextGray}"
                                      StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Popup x:Name="NotificationPopup" PlacementTarget="{Binding ElementName=NotificationButton}"
                   Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="340" MaxHeight="410" Padding="15" Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" Opacity="0.28" ShadowDepth="5" Color="Black" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="1,0,1,11">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Notifikasi siswa" FontSize="13" FontWeight="Medium"
                                       Foreground="{DynamicResource TextDark}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NotificationSummaryText" Grid.Column="1" Text="Terbaru" FontSize="9"
                                       Foreground="{DynamicResource TextGray}" VerticalAlignment="Center" />
                        </Grid>
                        <Border Grid.Row="1" Background="{DynamicResource BorderColor}" />
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <ScrollViewer x:Name="NotificationScrollViewer" MaxHeight="330" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="TopBarNotificationItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource ElevatedCardBackground}" CornerRadius="9"
                                                    Padding="11" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Medium"
                                                                   Foreground="{DynamicResource TextDark}" />
                                                        <TextBlock Text="{Binding StudentName}" FontSize="9"
                                                                   Foreground="{DynamicResource AccentText}" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Message}" FontSize="9" Foreground="{DynamicResource TextGray}"
                                                                   TextWrapping="Wrap" MaxWidth="265" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding DateText}" FontSize="8" Foreground="{DynamicResource TextGray}"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{Binding ReadStatusBackground}"
                                                            CornerRadius="6" Padding="6,3" VerticalAlignment="Top" Margin="7,0,0,0">
                                                        <TextBlock Text="{Binding ReadStatusText}" FontSize="8"
                                                                   Foreground="{Binding ReadStatusForeground}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock x:Name="NotificationEmptyText" Text="Belum ada notifikasi siswa."
                                       Foreground="{DynamicResource TextGray}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Border>
            </Popup>

            <Popup x:Name="ProfilePopup" PlacementTarget="{Binding ElementName=ProfileButton}"
                   Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Width="230" Padding="13" Background="{DynamicResource SurfaceBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" Opacity="0.28" ShadowDepth="5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="ProfileMenuNameText" Text="Arung" FontSize="13" FontWeight="Medium"
                                   Foreground="{DynamicResource TextDark}" />
                        <TextBlock x:Name="ProfileMenuUsernameText" Text="Bendahara" FontSize="9"
                                   Foreground="{DynamicResource TextGray}" Margin="0,2,0,8" />
                        <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,0,0,7" />
                        <Button Style="{StaticResource ShellMenuButton}" Click="TopBarThemeButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TopBarThemeIcon" Text="&#xE708;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Width="24" VerticalAlignment="Center" />
                                <TextBlock x:Name="TopBarThemeText" Text="Mode Gelap" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ShellMenuButton}" Foreground="{DynamicResource StatusRed}"
                                Click="LogoutButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Keluar" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <Frame x:Name="ContentFrame" Grid.Row="1" ClipToBounds="True" NavigationUIVisibility="Hidden"
                   Background="{DynamicResource PageBackground}" Navigated="ContentFrame_Navigated" />
        </Grid>

        <!--  Modal overlay: dialogs render here, inside the main window, instead of as separate OS windows  -->
        <Border x:Name="ModalOverlay" Grid.Column="0" Grid.ColumnSpan="2" Background="#99000000"
                Visibility="Collapsed" MouseLeftButtonDown="ModalOverlay_MouseLeftButtonDown">
            <Border Background="{DynamicResource SurfaceBackground}" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="960" Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Opacity="0.3" ShadowDepth="6" Color="Black" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
                    <ContentControl x:Name="ModalHost" />
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Window>
